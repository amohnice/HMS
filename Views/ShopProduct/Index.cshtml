@model HMS.Models.Common.PagedList<HMS.Models.Shop.ShopProduct>
@using HMS.Models.ViewModels
@using HMS.Services.Ui
@{
    ViewData["Title"] = "Shop Products";

    var search = ViewBag.Search as string;

    var head = new SurfaceHead
    {
        Title = "Products",
        Count = Model.TotalCount.ToString(),
        Search = new SurfaceSearch
        {
            Href = Url.Action("Index")!,
            Value = search,
            Placeholder = "Name or barcode…"
        },
        Actions =
        [
            new SurfaceAction
            {
                Label = "Add Product", Icon = "plus",
                Href = Url.Action("Create")!,
                Css = "btn btn-primary btn-sm",
                OpensDrawer = true, DrawerTitle = "New product"
            }
        ]
    };
}

<partial name="_SurfaceHead" model="head" />

@if (!Model.Items.Any())
{
    <partial name="_EmptyState" model="@(new EmptyState
    {
        Icon = "box",
        Title = string.IsNullOrWhiteSpace(search) ? "No products yet" : $"Nothing matches “{search}”",
        Text = "Add a product to start selling it at the shop till.",
        Action = new SurfaceAction
        {
            Label = "Add Product", Icon = "plus",
            Href = Url.Action("Create")!,
            OpensDrawer = true, DrawerTitle = "New product"
        }
    })" />
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover table-cards mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Product</th>
                        <th>Category</th>
                        <th>Barcode</th>
                        <th class="text-end">Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Items)
                    {
                        var activePill = StatusStyle.Availability(p.IsActive, "Active", "Inactive");

                        <tr>
                            <td class="ps-4">
                                <div class="fw-semibold">@p.Name</div>
                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                {
                                    <div class="text-muted small">@p.Description</div>
                                }
                            </td>
                            <td data-label="Category">@p.Category</td>
                            <td data-label="Barcode" class="text-muted">@(string.IsNullOrWhiteSpace(p.Barcode) ? "—" : p.Barcode)</td>
                            <td data-label="Price" class="text-end fw-semibold">Ksh @p.Price.ToString("N0")</td>
                            <td data-label="Stock"><partial name="_StatusPill" model="StatusStyle.Stock(p.StockQuantity)" /></td>
                            <td data-label="Status"><partial name="_StatusPill" model="activePill" /></td>
                            <td data-label="Actions" class="text-center">
                                <div class="btn-group">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="AuditTrail" asp-route-id="@p.Id" title="Stock history">Stock</a>
                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = p.Id })"
                                       data-drawer data-drawer-title="Edit @p.Name">Edit</a>
                                    <a class="btn btn-sm btn-outline-danger" href="@Url.Action("Delete", new { id = p.Id })"
                                       data-drawer data-drawer-title="Delete @p.Name">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model" />
    </div>
}
