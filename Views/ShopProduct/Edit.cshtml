@model HMS.Models.Shop.ShopProduct
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Edit Shop Product";
}

<partial name="_SurfaceHead" model="@(new SurfaceHead { Title = "Edit Product" })" />

<div class="form-page">
    <a class="form-back btn btn-sm btn-secondary align-self-start" asp-action="Index">Back to products</a>

    <form class="form-card" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-field">
            <label asp-for="Name" class="form-label">Product Name</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Category" class="form-label">Category</label>
                <input asp-for="Category" class="form-control" required />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="Barcode" class="form-label">Barcode / SKU</label>
                <input asp-for="Barcode" class="form-control" />
                <span asp-validation-for="Barcode" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Price" class="form-label">Selling Price</label>
                <div class="input-group">
                    <span class="input-group-text">Ksh</span>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                </div>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="StockQuantity" class="form-label">Stock Quantity</label>
                <input asp-for="StockQuantity" type="number" min="0" class="form-control" required />
                <span class="form-hint">Flagged low at 10 or fewer.</span>
                <span asp-validation-for="StockQuantity" class="text-danger"></span>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label asp-for="IsActive" class="form-check-label">Available at the till</label>
        </div>

        <div class="form-actions">
            <a class="btn btn-secondary btn-sm" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
