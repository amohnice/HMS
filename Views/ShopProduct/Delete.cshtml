@model HMS.Models.Shop.ShopProduct
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Delete Shop Product";
}

<partial name="_SurfaceHead" model="@(new SurfaceHead { Title = "Delete Product" })" />

<div class="form-page">
    <a class="form-back btn btn-sm btn-secondary align-self-start" asp-action="Index">Back to products</a>

    <form class="form-card" asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="form-warning">
            <span>
                Deleting <strong>@Model.Name</strong> removes it from the catalogue for good.
                Past sales keep its ID, but its details will no longer load.
            </span>
        </div>

        <dl class="form-review">
            <div class="form-review-row"><dt>Product</dt><dd>@Model.Name</dd></div>
            <div class="form-review-row"><dt>Category</dt><dd>@Model.Category</dd></div>
            <div class="form-review-row"><dt>Barcode</dt><dd>@(string.IsNullOrWhiteSpace(Model.Barcode) ? "—" : Model.Barcode)</dd></div>
            <div class="form-review-row"><dt>Price</dt><dd>Ksh @Model.Price.ToString("N0")</dd></div>
            <div class="form-review-row"><dt>Stock on hand</dt><dd>@Model.StockQuantity</dd></div>
        </dl>

        <div class="form-actions">
            <a class="btn btn-secondary btn-sm" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-danger btn-sm">Delete Product</button>
        </div>
    </form>
</div>
