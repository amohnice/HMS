@model HMS.Models.Common.PagedList<HMS.Models.Shop.StockMovement>
@using HMS.Models
@using HMS.Models.Shop
@using HMS.Models.ViewModels
@using HMS.Services.Ui
@{
    ViewData["Title"] = "Inventory Stock Audit Trail";

    var products = ViewBag.Products as List<ShopProduct> ?? [];
    var currentProductId = ViewBag.ProductId as int?;
    var currentType = ViewBag.TypeFilter as StockMovementType?;

    var chips = new List<FilterChip>
    {
        new()
        {
            Label = "All movements",
            Href = Url.Action("AuditTrail", new { productId = currentProductId })!,
            IsActive = currentType is null
        }
    };

    foreach (var type in Enum.GetValues<StockMovementType>())
    {
        chips.Add(new FilterChip
        {
            Label = StatusStyle.From(type).Text,
            Href = Url.Action("AuditTrail", new { productId = currentProductId, typeFilter = type })!,
            IsActive = currentType == type
        });
    }
}

<partial name="_SurfaceHead" model="@(new SurfaceHead
{
    Title = "Stock Audit Trail",
    Count = Model.TotalCount.ToString(),
    Actions =
    [
        new SurfaceAction { Label = "Products", Href = Url.Action("Index")!, Css = "btn btn-secondary btn-sm" }
    ]
})" />

<div class="surface-head">
    <form class="filter-bar" method="get" asp-action="AuditTrail">
        @if (currentType is not null)
        {
            <input type="hidden" name="typeFilter" value="@currentType" />
        }
        <div class="filter-field">
            <label for="productFilter">Product</label>
            <select id="productFilter" name="productId" onchange="this.form.submit()">
                <option value="">All products</option>
                @foreach (var p in products)
                {
                    <option value="@p.Id" selected="@(currentProductId == p.Id)">@p.Name (@p.StockQuantity)</option>
                }
            </select>
        </div>
        @if (currentProductId is not null || currentType is not null)
        {
            <a class="btn btn-secondary btn-sm" asp-action="AuditTrail">Clear</a>
        }
    </form>

    <div class="surface-head-actions">
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#adjustStockModal">
            <partial name="_Icon" model="@("plus")" />
            Adjust Stock
        </button>
    </div>
</div>

<partial name="_FilterChips" model="chips" />

@if (!Model.Items.Any())
{
    <partial name="_EmptyState" model="@(new EmptyState
    {
        Icon = "box",
        Title = "No stock movements recorded",
        Text = "Sales, restocks, adjustments and spoilage all appear here as they happen."
    })" />
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover table-cards mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">When</th>
                        <th>Product</th>
                        <th>Movement</th>
                        <th class="text-center">Change</th>
                        <th>Reason</th>
                        <th class="pe-4">By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Items)
                    {
                        var up = m.QuantityDelta > 0;
                        var pill = StatusStyle.From(m.MovementType);

                        <tr>
                            <td class="ps-4 text-muted small">@m.Timestamp.ToString("dd MMM · HH:mm")</td>
                            <td data-label="Product" class="fw-semibold">@m.Product?.Name</td>
                            <td data-label="Movement"><partial name="_StatusPill" model="pill" /></td>
                            <td data-label="Change" class="text-center">
                                <span class="delta @(up ? "delta--up" : "delta--down")">@(up ? "+" : "")@m.QuantityDelta</span>
                            </td>
                            <td data-label="Reason" class="text-muted small">@(string.IsNullOrWhiteSpace(m.Reason) ? "—" : m.Reason)</td>
                            <td data-label="By" class="pe-4 small">@(m.PerformedByUser?.FullName ?? "System POS")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model" />
    </div>
}

@* Stock adjustment stays a modal: it is a decision about one product taken from
   anywhere on the page, not a record you edit in place. *@
<div class="modal fade" id="adjustStockModal" tabindex="-1" aria-labelledby="adjustStockLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="AdjustStock" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="adjustStockLabel">Adjust Stock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="form-field mb-3">
                        <label class="form-label" for="adjProduct">Product</label>
                        <select id="adjProduct" name="productId" class="form-select" required>
                            @foreach (var p in products)
                            {
                                <option value="@p.Id">@p.Name — @p.StockQuantity in stock</option>
                            }
                        </select>
                    </div>

                    <div class="form-field mb-3">
                        <label class="form-label" for="adjType">Movement</label>
                        <select id="adjType" name="movementType" class="form-select" required>
                            <option value="@StockMovementType.Restock">Restock — add stock</option>
                            <option value="@StockMovementType.DamageSpoilage">Damage or spoilage — remove stock</option>
                            <option value="@StockMovementType.ManualAdjustment">Manual adjustment</option>
                            <option value="@StockMovementType.Return">Customer return — add stock</option>
                        </select>
                    </div>

                    <div class="form-field mb-3">
                        <label class="form-label" for="adjDelta">Change</label>
                        <input id="adjDelta" type="number" name="quantityDelta" class="form-control"
                               placeholder="20 to add, -5 to remove" required />
                        <span class="form-hint">Positive adds stock, negative removes it.</span>
                    </div>

                    <div class="form-field">
                        <label class="form-label" for="adjReason">Reason</label>
                        <input id="adjReason" type="text" name="reason" class="form-control"
                               placeholder="e.g. Supplier invoice #4092" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Save Adjustment</button>
                </div>
            </form>
        </div>
    </div>
</div>
