@model HMS.Models.Common.PagedList<HMS.Models.Shop.StockMovement>
@using HMS.Models
@using HMS.Models.Shop
@{
    ViewData["Title"] = "Inventory Stock Audit Trail";
    var products = ViewBag.Products as List<ShopProduct> ?? new List<ShopProduct>();
    int? currentProductId = ViewBag.ProductId as int?;
    StockMovementType? currentType = ViewBag.TypeFilter as StockMovementType?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-0 fw-bold">Inventory Audit Trail</h1>
        <p class="text-muted">Track all stock changes (Sales, Restocks, Manual Adjustments, Spoilage)</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary d-inline-flex align-items-center" data-bs-toggle="modal" data-bs-target="#adjustStockModal">
            <svg class="me-2" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Adjust Stock / Restock
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Products List</a>
    </div>
</div>

<!-- Filters Card -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="AuditTrail" class="row g-3 align-items-center">
            <div class="col-md-5">
                <label class="form-label small fw-bold">Filter by Product</label>
                <select name="productId" class="form-select" onchange="this.form.submit()">
                    <option value="">All Products</option>
                    @foreach (var p in products)
                    {
                        <option value="@p.Id" selected="@(currentProductId == p.Id ? "selected" : null)">@p.Name (Qty: @p.StockQuantity)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold">Movement Type</label>
                <select name="typeFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Movement Types</option>
                    @foreach (StockMovementType type in Enum.GetValues(typeof(StockMovementType)))
                    {
                        <option value="@type" selected="@(currentType == type ? "selected" : null)">@type</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <a asp-action="AuditTrail" class="btn btn-outline-secondary w-100">Clear Filters</a>
            </div>
        </form>
    </div>
</div>

<!-- Audit Trail Table -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Timestamp</th>
                    <th>Product</th>
                    <th>Movement Type</th>
                    <th class="text-center">Qty Delta</th>
                    <th>Reason / Notes</th>
                    <th class="pe-4">Performed By</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <svg class="mb-3" width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                            <p class="mb-0">No stock movement logs found.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var m in Model.Items)
                    {
                        var isPositive = m.QuantityDelta > 0;
                        var badgeClass = m.MovementType switch
                        {
                            StockMovementType.Sale => "bg-primary text-white",
                            StockMovementType.Restock => "bg-success text-white",
                            StockMovementType.DamageSpoilage => "bg-danger text-white",
                            StockMovementType.ManualAdjustment => "bg-info text-dark",
                            StockMovementType.Return => "bg-warning text-dark",
                            _ => "bg-secondary text-white"
                        };

                        <tr>
                            <td class="ps-4 text-muted small">@m.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-bold">@m.Product?.Name</td>
                            <td><span class="badge @badgeClass">@m.MovementType</span></td>
                            <td class="text-center fw-bold fs-6 @(isPositive ? "text-success" : "text-danger")">
                                @(isPositive ? "+" : "")@m.QuantityDelta
                            </td>
                            <td class="text-muted small">@(string.IsNullOrWhiteSpace(m.Reason) ? "N/A" : m.Reason)</td>
                            <td class="pe-4 small fw-semibold">@(m.PerformedByUser?.FullName ?? "System POS")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="Model" />
</div>

<!-- Modal: Adjust Stock -->
<div class="modal fade" id="adjustStockModal" tabindex="-1" aria-labelledby="adjustStockModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AdjustStock" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="adjustStockModalLabel">Adjust Product Stock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-content-body p-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Product</label>
                        <select name="productId" class="form-select" required>
                            @foreach (var p in products)
                            {
                                <option value="@p.Id">@p.Name (Current Stock: @p.StockQuantity)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Movement Type</label>
                        <select name="movementType" class="form-select" required>
                            <option value="@StockMovementType.Restock">Restock (+ Add Stock)</option>
                            <option value="@StockMovementType.DamageSpoilage">Damage / Spoilage (- Remove Stock)</option>
                            <option value="@StockMovementType.ManualAdjustment">Manual Adjustment (+/-)</option>
                            <option value="@StockMovementType.Return">Customer Return (+ Add Stock)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Quantity Delta (+ or -)</label>
                        <input type="number" name="quantityDelta" class="form-control" placeholder="e.g. 20 for restock, -5 for damage" required />
                        <span class="form-text">Use positive numbers to add stock, negative numbers to reduce stock.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Reason / Reference Notes</label>
                        <input type="text" name="reason" class="form-control" placeholder="e.g. Supplier Invoice #4092 or Broken bottles" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Adjustment</button>
                </div>
            </form>
        </div>
    </div>
</div>
