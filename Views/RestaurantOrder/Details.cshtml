@model HMS.Models.Restaurant.RestaurantOrder
@using HMS.Models
@using HMS.Models.ViewModels
@using HMS.Services.Ui
@{
    ViewData["Title"] = "Order Details";
}

<partial name="_SurfaceHead" model="@(new SurfaceHead
{
    Title = $"Order #{Model.Id:D4}",
    Actions =
    [
        new SurfaceAction { Label = "All orders", Href = Url.Action("Index")!, Css = "btn btn-secondary btn-sm" }
    ]
})" />

<div class="detail-columns">

    <section class="card bill">
        <header class="bill-head">
            <div>
                <h2 class="bill-title">Table @Model.Table.TableNumber</h2>
                <span class="bill-meta">
                    @(string.IsNullOrWhiteSpace(Model.CustomerName) ? "Guest" : Model.CustomerName)
                    · served by @Model.Waiter.FullName
                </span>
            </div>
            <partial name="_StatusPill" model="StatusStyle.From(Model.Status)" />
        </header>

        <div class="bill-lines">
            @foreach (var item in Model.Items)
            {
                <div class="bill-line">
                    <span class="bill-line-qty">@item.Quantity&times;</span>
                    <span class="bill-line-name">
                        @item.MenuItem.Name
                        <span class="bill-line-sub">@item.MenuItem.Category</span>
                    </span>
                    <span class="bill-line-unit">@@ Ksh @item.UnitPrice.ToString("N0")</span>
                    <span class="bill-line-amount">Ksh @item.LineTotal.ToString("N0")</span>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <p class="bill-note"><strong>Notes:</strong> @Model.Notes</p>
        }

        <footer class="bill-total">
            <span>Total</span>
            <span>Ksh @Model.TotalAmount.ToString("N0")</span>
        </footer>
    </section>

    <aside class="detail-side">
        <section class="card">
            <header class="dash-panel-head">
                <h2 class="dash-panel-title">Order</h2>
            </header>
            <dl class="detail-facts">
                <div><dt>Placed</dt><dd>@Model.OrderTime.ToString("dd MMM yyyy · HH:mm")</dd></div>
                <div><dt>Table</dt><dd>@Model.Table.TableNumber</dd></div>
                <div><dt>Waiter</dt><dd>@Model.Waiter.FullName</dd></div>
                <div><dt>Items</dt><dd>@Model.Items.Sum(i => i.Quantity)</dd></div>
            </dl>
        </section>

        @if (Model.Status == RestaurantOrderStatus.Paid)
        {
            <section class="card">
                <header class="dash-panel-head">
                    <h2 class="dash-panel-title">Payment</h2>
                </header>
                <dl class="detail-facts">
                    <div><dt>Method</dt><dd>@Model.PaymentMethod</dd></div>
                    <div><dt>Paid</dt><dd>Ksh @(Model.AmountPaid?.ToString("N0") ?? "—")</dd></div>
                    <div><dt>Change</dt><dd>Ksh @(Model.ChangeAmount?.ToString("N0") ?? "—")</dd></div>
                    @if (Model.PaidAt is not null)
                    {
                        <div><dt>Settled</dt><dd>@Model.PaidAt.Value.ToString("dd MMM · HH:mm")</dd></div>
                    }
                </dl>
            </section>
        }
    </aside>
</div>
