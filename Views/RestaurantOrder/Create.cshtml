@using HMS.Models.Restaurant
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Take Restaurant Order";

    var tables = (List<RestaurantTable>)ViewBag.Tables;
    var menuItems = (List<RestaurantMenu>)ViewBag.MenuItems;
    var categories = menuItems.Select(m => m.Category).Distinct().ToList();
}

<partial name="_SurfaceHead" model="@(new SurfaceHead
{
    Title = "New Order",
    Count = $"{menuItems.Count} dishes",
    Actions =
    [
        new SurfaceAction { Label = "All Orders", Href = Url.Action("Index")!, Css = "btn btn-secondary btn-sm" }
    ]
})" />

<div class="pos-layout">

    @* ============ BROWSE ============ *@
    <div class="pos-browse">

        @* Filtering happens client-side over ONE grid. The previous version
           rendered the whole grid again per category into hidden tab panes. *@
        <div class="chip-row" id="dishFilters">
            <button type="button" class="chip is-active" data-filter="all">
                All
                <span class="chip-count">@menuItems.Count</span>
            </button>
            @foreach (var category in categories)
            {
                <button type="button" class="chip" data-filter="@category">
                    @category
                    <span class="chip-count">@menuItems.Count(m => m.Category == category)</span>
                </button>
            }
        </div>

        <div class="pos-menu-grid" id="dishGrid">
            @foreach (var item in menuItems)
            {
                <div class="dish-tile" data-dish="@item.Id" data-category="@item.Category"
                     data-name="@item.Name" data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <span class="dish-tile-kind">@item.Category</span>
                    <span class="dish-tile-name">@item.Name</span>

                    <div class="dish-tile-foot">
                        <span class="dish-tile-price">Ksh @item.Price.ToString("N0")</span>

                        @* The stepper lives here, not in the cart: quantity is edited
                           where you browse and only reviewed in the rail. *@
                        <span class="stepper">
                            <button type="button" class="stepper-btn stepper-btn--sub" data-step="-1" aria-label="Remove one @item.Name">&minus;</button>
                            <span class="stepper-value" data-qty>0</span>
                            <button type="button" class="stepper-btn stepper-btn--add" data-step="1" aria-label="Add one @item.Name">+</button>
                        </span>
                    </div>
                </div>
            }
        </div>

        @if (menuItems.Count == 0)
        {
            <partial name="_EmptyState" model="@(new EmptyState
            {
                Icon = "book",
                Title = "No dishes are available",
                Text = "Menu items must be marked available before they can be ordered."
            })" />
        }
    </div>

    @* ============ CART RAIL ============ *@
    <form class="cart-rail" id="orderForm" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div id="cartInputs"></div>

        <div class="cart-head">
            <div class="cart-head-row">
                <div>
                    <h2 class="cart-head-title" id="cartTableLabel">Select a table</h2>
                    <span class="cart-head-meta" id="cartTableMeta"></span>
                </div>
                <div class="cart-head-actions">
                    <button type="button" class="cart-icon-btn" id="cartTableEdit" title="Change table" hidden>
                        <partial name="_Icon" model="@("plus-doc")" />
                    </button>
                    <button type="button" class="cart-icon-btn cart-icon-btn--danger" id="cartClear" title="Clear order">
                        <partial name="_Icon" model="@("refresh")" />
                    </button>
                </div>
            </div>

            <div class="cart-head-row" id="cartTablePicker">
                <select name="tableId" class="form-select form-select-sm" id="tableSelect" required>
                    <option value="" disabled selected>Choose table…</option>
                    @foreach (var table in tables)
                    {
                        <option value="@table.Id" data-label="Table @table.TableNumber" data-covers="@table.Capacity">
                            Table @table.TableNumber · seats @table.Capacity · @table.Status
                        </option>
                    }
                </select>
            </div>

            <div class="cart-extras">
                <button type="button" class="cart-extras-toggle" data-reveal="#cartExtras">＋ Customer &amp; notes</button>
                <div id="cartExtras" hidden class="cart-extras">
                    <input name="customerName" type="text" class="form-control form-control-sm" placeholder="Customer name (optional)" />
                    <textarea name="notes" class="form-control form-control-sm" rows="2" placeholder="Notes for the kitchen"></textarea>
                </div>
            </div>
        </div>

        <hr class="cart-rule" />

        <div class="cart-items">
            <div class="cart-section-head">
                <span>Ordered Items</span>
                <span class="cart-section-count" id="cartCount">00</span>
            </div>
            <div id="cartLines">
                <div class="cart-empty">Tap a dish to add it.</div>
            </div>
        </div>

        <hr class="cart-rule" />

        <div class="cart-summary">
            <div class="cart-summary-row">
                <span>Items</span>
                <span id="cartQtyTotal">0</span>
            </div>
            <div class="cart-summary-row cart-summary-row--total">
                <span>Total Payable</span>
                <span id="cartTotal">Ksh 0</span>
            </div>
        </div>

        <div class="cart-foot">
            <a class="btn btn-secondary btn-sm" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary btn-sm" id="cartSubmit" disabled>Send to Kitchen</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    var grid   = document.getElementById('dishGrid');
    var form   = document.getElementById('orderForm');
    var lines  = document.getElementById('cartLines');
    var inputs = document.getElementById('cartInputs');
    var select = document.getElementById('tableSelect');

    // Quantity by dish id. The tiles are the source of truth for editing;
    // this is just the projection the rail and the POST body read from.
    var cart = {};

    function money(n) {
        return 'Ksh ' + n.toLocaleString('en-KE', { maximumFractionDigits: 0 });
    }

    function tileOf(id) { return grid.querySelector('[data-dish="' + id + '"]'); }

    function setQty(tile, qty) {
        var id = tile.getAttribute('data-dish');
        if (qty <= 0) {
            delete cart[id];
        } else {
            cart[id] = {
                name: tile.getAttribute('data-name'),
                price: parseFloat(tile.getAttribute('data-price')),
                qty: qty
            };
        }
        tile.querySelector('[data-qty]').textContent = qty;
        tile.classList.toggle('is-selected', qty > 0);
        render();
    }

    function render() {
        var ids = Object.keys(cart);
        var totalQty = 0, total = 0;

        if (ids.length === 0) {
            lines.innerHTML = '<div class="cart-empty">Tap a dish to add it.</div>';
        } else {
            lines.innerHTML = '';
            ids.forEach(function (id) {
                var line = cart[id];
                var amount = line.price * line.qty;
                totalQty += line.qty;
                total += amount;

                var row = document.createElement('div');
                row.className = 'cart-line';
                row.innerHTML =
                    '<span class="cart-line-qty">' + line.qty + '&times;</span>' +
                    '<span class="cart-line-name"></span>' +
                    '<span class="cart-line-amount">' + money(amount) + '</span>' +
                    '<button type="button" class="cart-line-drop" data-drop="' + id + '" aria-label="Remove">&times;</button>';
                row.querySelector('.cart-line-name').textContent = line.name;  // never trust names into HTML
                lines.appendChild(row);
            });
        }

        document.getElementById('cartCount').textContent = ('0' + ids.length).slice(-2);
        document.getElementById('cartQtyTotal').textContent = totalQty;
        document.getElementById('cartTotal').textContent = money(total);
        document.getElementById('cartSubmit').disabled = ids.length === 0 || !select.value;
    }

    // --- Stepper on the tiles ---
    grid?.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-step]');
        if (!btn) return;
        var tile = btn.closest('[data-dish]');
        var current = parseInt(tile.querySelector('[data-qty]').textContent, 10) || 0;
        setQty(tile, current + parseInt(btn.getAttribute('data-step'), 10));
    });

    // --- Remove from the rail ---
    lines.addEventListener('click', function (e) {
        var drop = e.target.closest('[data-drop]');
        if (drop) setQty(tileOf(drop.getAttribute('data-drop')), 0);
    });

    // --- Category filter over the single grid ---
    document.getElementById('dishFilters')?.addEventListener('click', function (e) {
        var chip = e.target.closest('[data-filter]');
        if (!chip) return;
        var want = chip.getAttribute('data-filter');

        this.querySelectorAll('[data-filter]').forEach(function (c) {
            c.classList.toggle('is-active', c === chip);
        });
        grid.querySelectorAll('[data-dish]').forEach(function (tile) {
            tile.hidden = want !== 'all' && tile.getAttribute('data-category') !== want;
        });
    });

    // --- Table choice collapses into the header ---
    function applyTable() {
        var opt = select.selectedOptions[0];
        var picker = document.getElementById('cartTablePicker');
        var editBtn = document.getElementById('cartTableEdit');

        if (!select.value || !opt) return;

        document.getElementById('cartTableLabel').textContent = opt.getAttribute('data-label');
        document.getElementById('cartTableMeta').textContent = 'Seats ' + opt.getAttribute('data-covers');
        picker.hidden = true;
        editBtn.hidden = false;
        render();
    }

    select?.addEventListener('change', applyTable);

    document.getElementById('cartTableEdit')?.addEventListener('click', function () {
        document.getElementById('cartTablePicker').hidden = false;
        this.hidden = true;
    });

    // --- Clear ---
    document.getElementById('cartClear')?.addEventListener('click', function () {
        Object.keys(cart).forEach(function (id) {
            var tile = tileOf(id);
            if (tile) {
                tile.querySelector('[data-qty]').textContent = '0';
                tile.classList.remove('is-selected');
            }
        });
        cart = {};
        render();
    });

    // --- Submit: expand the cart into the array pairs the action expects ---
    form.addEventListener('submit', function (e) {
        if (Object.keys(cart).length === 0) {
            e.preventDefault();
            return;
        }
        inputs.innerHTML = '';
        Object.keys(cart).forEach(function (id) {
            inputs.insertAdjacentHTML('beforeend',
                '<input type="hidden" name="menuItemIds" value="' + id + '">' +
                '<input type="hidden" name="quantities" value="' + cart[id].qty + '">');
        });
    });

    render();
})();
</script>
}
