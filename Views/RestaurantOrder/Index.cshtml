@model IEnumerable<HMS.Models.Restaurant.RestaurantOrder>
@using HMS.Models
@{
    ViewData["Title"] = "Restaurant Orders";
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Orders</h1>
        <p class="page-subheading">Take orders, track prep status, and view history</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center">
            <svg class="me-2" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Take Order
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white border-0">
        <h5 class="mb-0 fw-bold">Recent Orders</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Order ID</th>
                    <th>Time</th>
                    <th>Table</th>
                    <th>Customer</th>
                    <th>Waiter</th>
                    <th>Status</th>
                    <th class="text-end">Total</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <svg class="mb-3" width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                            <p class="mb-0">No orders found.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var order in Model)
                    {
                        var statusClass = order.Status switch
                        {
                            RestaurantOrderStatus.Pending => "order-pending",
                            RestaurantOrderStatus.Preparing => "order-preparing",
                            RestaurantOrderStatus.Ready => "order-ready",
                            RestaurantOrderStatus.Served => "order-served",
                            RestaurantOrderStatus.Paid => "order-paid",
                            RestaurantOrderStatus.Cancelled => "order-cancelled",
                            _ => ""
                        };

                        <tr>
                            <td class="ps-4 fw-bold">#@order.Id</td>
                            <td>@order.OrderTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-secondary">Table @order.Table.TableNumber</span></td>
                            <td>@(string.IsNullOrWhiteSpace(order.CustomerName) ? "Guest" : order.CustomerName)</td>
                            <td>@order.Waiter.FullName</td>
                            <td><span class="badge-status @statusClass">@order.Status</span></td>
                            <td class="text-end fw-bold text-primary">Ksh @order.TotalAmount.ToString("N2")</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary py-1 px-3">Details</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
