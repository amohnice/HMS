@model HMS.Models.Common.PagedList<HMS.Models.Restaurant.RestaurantOrder>
@using HMS.Models
@using HMS.Models.ViewModels
@using HMS.Services.Ui
@{
    ViewData["Title"] = "Restaurant Orders";

    var active = ViewBag.StatusFilter as RestaurantOrderStatus?;
    var counts = ViewBag.StatusCounts as Dictionary<RestaurantOrderStatus, int> ?? [];
    @* This controller is waiter/admin only, so order details is always reachable here. *@
    var live = new OrderQueue
    {
        Orders = ViewBag.LiveOrders as List<HMS.Models.Restaurant.RestaurantOrder> ?? [],
        HrefFormat = "/RestaurantOrder/Details/{0}"
    };

    @* Chips replace what used to be separate pages for the same records. *@
    var chips = new List<FilterChip>
    {
        new()
        {
            Label = "All",
            Count = counts.Values.Sum(),
            Href = Url.Action("Index")!,
            IsActive = active is null
        }
    };

    foreach (var status in Enum.GetValues<RestaurantOrderStatus>())
    {
        chips.Add(new FilterChip
        {
            Label = status.ToString(),
            Count = counts.TryGetValue(status, out var n) ? n : 0,
            Href = Url.Action("Index", new { statusFilter = status })!,
            IsActive = active == status
        });
    }

    var head = new SurfaceHead
    {
        Title = active is null ? "Orders" : $"{active} Orders",
        Count = Model.TotalCount.ToString(),
        Actions =
        [
            new SurfaceAction
            {
                Label = "Take Order", Icon = "plus",
                Href = Url.Action("Create")!,
                Css = "btn btn-primary btn-sm"
            }
        ]
    };
}

<partial name="_SurfaceHead" model="head" />

@* What is on the floor right now, before the history table. *@
<partial name="_OrderQueue" model="live" />

<partial name="_FilterChips" model="chips" />

@if (!Model.Items.Any())
{
    <partial name="_EmptyState" model="@(new EmptyState
    {
        Icon = "list",
        Title = active is null ? "No orders yet" : $"No {active} orders",
        Text = "Orders appear here as waiters take them.",
        Action = new SurfaceAction
        {
            Label = "Take Order", Icon = "plus",
            Href = Url.Action("Create")!
        }
    })" />
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover table-cards mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Order</th>
                        <th>Time</th>
                        <th>Table</th>
                        <th>Customer</th>
                        <th>Waiter</th>
                        <th>Status</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Items)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#@order.Id.ToString("D4")</td>
                            <td data-label="Time">@order.OrderTime.ToString("dd MMM HH:mm")</td>
                            <td data-label="Table">Table @order.Table?.TableNumber</td>
                            <td data-label="Customer">@(string.IsNullOrWhiteSpace(order.CustomerName) ? "Guest" : order.CustomerName)</td>
                            <td data-label="Waiter">@order.Waiter?.FullName</td>
                            <td data-label="Status"><partial name="_StatusPill" model="StatusStyle.From(order.Status)" /></td>
                            <td data-label="Total" class="text-end fw-semibold">Ksh @order.TotalAmount.ToString("N0")</td>
                            <td data-label="Actions" class="text-center">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@order.Id">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model" />
    </div>
}
