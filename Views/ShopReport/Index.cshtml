@model HMS.Models.ViewModels.ShopReportViewModel
@using HMS.Models.ViewModels
@using HMS.Services.Ui
@{
    ViewData["Title"] = "Shop Sales Report";
    var periods = new[] { "daily", "weekly", "monthly" };
}

<partial name="_SurfaceHead" model="@(new SurfaceHead
{
    Title = "Shop Reports",
    Actions =
    [
        new SurfaceAction
        {
            Label = "Export CSV",
            Href = Url.Action("ExportCsv", new { Model.Filter.Period, Model.Filter.StartDate, Model.Filter.EndDate })!,
            Css = "btn btn-secondary btn-sm"
        }
    ]
})" />

<div class="chip-row">
    @foreach (var period in periods)
    {
        <a class="chip @(string.Equals(Model.Filter.Period, period, StringComparison.OrdinalIgnoreCase) ? "is-active" : "")"
           asp-action="Index" asp-route-Period="@period">
            @(char.ToUpper(period[0]) + period[1..])
        </a>
    }
</div>

<form class="filter-bar" method="get">
    <input type="hidden" name="Period" value="@Model.Filter.Period" />
    <div class="filter-field">
        <label for="startDate">From</label>
        <input id="startDate" type="date" name="StartDate" value="@Model.Filter.StartDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter-field">
        <label for="endDate">To</label>
        <input id="endDate" type="date" name="EndDate" value="@Model.Filter.EndDate.ToString("yyyy-MM-dd")" />
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
</form>

<div class="kpi-strip">
    <div class="kpi">
        <span class="kpi-label">Retail revenue</span>
        <span class="kpi-value">Ksh @Model.TotalRevenue.ToString("N0")</span>
        <span class="kpi-sub">Shop sales in range</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Transactions</span>
        <span class="kpi-value">@Model.TotalSales</span>
        <span class="kpi-sub">Tickets processed</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Average ticket</span>
        <span class="kpi-value">
            Ksh @((Model.TotalSales == 0 ? 0 : Model.TotalRevenue / Model.TotalSales).ToString("N0"))
        </span>
        <span class="kpi-sub">Per sale</span>
    </div>
</div>

<div class="dash-columns">
    <section class="card">
        <header class="dash-panel-head">
            <h2 class="dash-panel-title">Top selling products</h2>
        </header>

        @if (!Model.TopProducts.Any())
        {
            <p class="dash-panel-clear">No sales in this period.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-cards report-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Product</th>
                            <th class="text-center">Sold</th>
                            <th class="text-end pe-4">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.TopProducts)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.Name</td>
                                <td data-label="Sold" class="text-center">@item.Quantity</td>
                                <td data-label="Revenue" class="text-end fw-semibold pe-4">Ksh @item.Revenue.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <header class="dash-panel-head">
            <h2 class="dash-panel-title">Low stock</h2>
            <span class="dash-panel-link">&le; 10 units</span>
        </header>

        @if (!Model.LowStockProducts.Any())
        {
            <p class="dash-panel-clear">Every product is above the reorder level.</p>
        }
        else
        {
            <ul class="dash-list">
                @foreach (var p in Model.LowStockProducts)
                {
                    var pill = StatusStyle.Stock(p.StockQuantity);
                    <li>
                        <a class="dash-row" href="@Url.Action("Edit", "ShopProduct", new { id = p.Id })"
                           data-drawer data-drawer-title="Restock @p.Name">
                            <span class="dash-row-main">
                                <span class="dash-row-title">@p.Name</span>
                                <span class="dash-row-detail">@p.Category</span>
                            </span>
                            <span class="dash-row-side">
                                <partial name="_StatusPill" model="pill" />
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
    </section>
</div>
