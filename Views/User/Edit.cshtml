@model HMS.Models.ViewModels.EditUserViewModel
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Edit Staff Details";
    var roles = ViewBag.AvailableRoles as string[] ?? [];
}

<partial name="_SurfaceHead" model="@(new SurfaceHead { Title = "Edit Staff Account" })" />

<div class="form-page">
    <a class="form-back btn btn-sm btn-secondary align-self-start" asp-action="Index">Back to staff list</a>

    <form class="form-card" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-field">
            <label asp-for="FullName" class="form-label">Full Name</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Email" class="form-label">Email Address</label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Role" class="form-label">Role</label>
            <select asp-for="Role" class="form-select">
                @foreach (var r in roles)
                {
                    <option value="@r">@r</option>
                }
            </select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>

        <div class="form-review">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label">Account active</label>
            </div>
            <span class="form-hint">Inactive staff cannot sign in.</span>
        </div>

        <div class="form-actions">
            <a class="btn btn-secondary btn-sm" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
