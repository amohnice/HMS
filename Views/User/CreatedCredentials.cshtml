@model HMS.Models.ViewModels.UserCredentialsViewModel
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = Model.IsNewUser ? "Staff Credentials Generated" : "Password Reset";
}

<partial name="_SurfaceHead" model="@(new SurfaceHead
{
    Title = Model.IsNewUser ? "Account created" : "Password reset"
})" />

<div class="form-page">
    <div class="app-alert app-alert-success">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>
            @(Model.IsNewUser
                ? $"{Model.FullName} can now sign in as {Model.Role}."
                : $"A new password has been generated for {Model.FullName}.")
        </span>
    </div>

    <section class="form-card">
        <dl class="form-review">
            <div class="form-review-row"><dt>Name</dt><dd>@Model.FullName</dd></div>
            <div class="form-review-row"><dt>Role</dt><dd>@Model.Role</dd></div>
        </dl>

        @* Read-only credential rows, each with its own copy button. *@
        <div class="form-field">
            <label class="form-label" for="emailInput">Username</label>
            <div class="copy-row">
                <input id="emailInput" class="form-control" value="@Model.Email" readonly />
                <button type="button" class="btn btn-secondary btn-sm" data-copy="#emailInput" data-copy-label="Username">Copy</button>
            </div>
        </div>

        <div class="form-field">
            <label class="form-label" for="passInput">Temporary password</label>
            <div class="copy-row">
                <input id="passInput" class="form-control copy-strong" value="@Model.TemporaryPassword" readonly />
                <button type="button" class="btn btn-primary btn-sm" data-copy="#passInput" data-copy-label="Password">Copy</button>
            </div>
            <span class="form-hint">Shown once. They should change it after signing in.</span>
        </div>

        <div class="form-field">
            <label class="form-label" for="urlInput">Login link</label>
            <div class="copy-row">
                <input id="urlInput" class="form-control" value="@Model.LoginUrl" readonly />
                <button type="button" class="btn btn-secondary btn-sm" data-copy="#urlInput" data-copy-label="Login link">Copy</button>
            </div>
        </div>

        <hr class="rule-dotted" />

        <div class="form-review">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <div>
                    <div class="fw-semibold">Shareable message</div>
                    <div class="form-hint">Everything above, formatted for SMS or WhatsApp.</div>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" id="copyAll">Copy all</button>
            </div>
        </div>

        <div class="form-actions">
            <a class="btn btn-secondary btn-sm" asp-action="Index">Back to staff</a>
            <a class="btn btn-primary btn-sm" asp-action="Create">Add another</a>
        </div>
    </section>
</div>

<div class="copy-toast" id="copyToast" role="status" aria-live="polite" hidden></div>

@section Scripts {
<script>
(function () {
    'use strict';

    var toast = document.getElementById('copyToast');

    function flash(message) {
        toast.textContent = message;
        toast.hidden = false;
        clearTimeout(flash._t);
        flash._t = setTimeout(function () { toast.hidden = true; }, 2500);
    }

    function copy(text, label) {
        // The async clipboard API needs a secure context; fall back for plain http,
        // which is how this app is often served on a local network.
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text)
                .then(function () { flash(label + ' copied'); })
                .catch(function () { flash('Could not copy — select and copy manually'); });
            return;
        }

        var scratch = document.createElement('textarea');
        scratch.value = text;
        scratch.style.position = 'fixed';
        scratch.style.opacity = '0';
        document.body.appendChild(scratch);
        scratch.select();
        try {
            document.execCommand('copy');
            flash(label + ' copied');
        } catch (e) {
            flash('Could not copy — select and copy manually');
        }
        document.body.removeChild(scratch);
    }

    document.querySelectorAll('[data-copy]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var field = document.querySelector(btn.getAttribute('data-copy'));
            if (field) copy(field.value, btn.getAttribute('data-copy-label') || 'Value');
        });
    });

    document.getElementById('copyAll').addEventListener('click', function () {
        copy(
            'Welcome to HMS, @Model.FullName!\n\n' +
            'Role: @Model.Role\n' +
            'Login: @Model.LoginUrl\n' +
            'Username: @Model.Email\n' +
            'Temporary password: @Model.TemporaryPassword\n\n' +
            'Please sign in and change your password.',
            'All details');
    });
})();
</script>
}
