@model HMS.Models.ViewModels.UserCredentialsViewModel
@{
    ViewData["Title"] = Model.IsNewUser ? "Staff Credentials Generated" : "Password Reset Successful";
}

<div class="container-fluid px-0" style="max-width: 650px;">
    <!-- Alert Banner -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
        <div class="bg-success text-white p-4 text-center">
            <div class="d-inline-flex align-items-center justify-content-center bg-white bg-opacity-25 rounded-circle mb-3" style="width: 56px; height: 56px;">
                <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h2 class="h4 fw-bold mb-1">@(Model.IsNewUser ? "Staff Credentials Generated!" : "Password Reset Successfully!")</h2>
            <p class="mb-0 text-white-50 small">Share these initial credentials or login link directly with the staff member.</p>
        </div>

        <div class="card-body p-4 bg-white">
            <!-- Staff Details -->
            <div class="border-bottom pb-3 mb-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-muted fs-7 text-uppercase fw-semibold d-block mb-1">Full Name</span>
                        <span class="fw-bold text-dark fs-6">@Model.FullName</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted fs-7 text-uppercase fw-semibold d-block mb-1">Role Assigned</span>
                        <span class="badge bg-primary px-2.5 py-1.5 rounded-pill fw-medium fs-7">@Model.Role</span>
                    </div>
                </div>
            </div>

            <!-- Credentials Box -->
            <div class="mb-4">
                <!-- Username / Email -->
                <div class="mb-3">
                    <label class="form-label text-muted fs-7 text-uppercase fw-semibold mb-1">Login Username (Email)</label>
                    <div class="input-group">
                        <input type="text" class="form-control bg-light font-monospace" id="emailInput" value="@Model.Email" readonly />
                        <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('emailInput', 'Email')">
                            Copy Email
                        </button>
                    </div>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label class="form-label text-muted fs-7 text-uppercase fw-semibold mb-1">Temporary Password</label>
                    <div class="input-group">
                        <input type="text" class="form-control bg-light font-monospace fw-bold text-primary fs-5" id="passInput" value="@Model.TemporaryPassword" readonly />
                        <button class="btn btn-primary" type="button" onclick="copyToClipboard('passInput', 'Password')">
                            Copy Password
                        </button>
                    </div>
                </div>

                <!-- Login URL -->
                <div class="mb-3">
                    <label class="form-label text-muted fs-7 text-uppercase fw-semibold mb-1">HMS Login Link</label>
                    <div class="input-group">
                        <input type="text" class="form-control bg-light font-monospace small" id="urlInput" value="@Model.LoginUrl" readonly />
                        <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('urlInput', 'Login Link')">
                            Copy Link
                        </button>
                    </div>
                </div>
            </div>

            <!-- Quick Action: Copy Full Summary -->
            <div class="bg-light p-3 rounded-3 border mb-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-semibold text-dark mb-0">Shareable Summary</div>
                        <div class="text-muted small">Copy entire formatted message for SMS or WhatsApp.</div>
                    </div>
                    <button class="btn btn-dark btn-sm px-3 fw-medium" onclick="copyFullSummary()">
                        Copy All Details
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    Back to Staff List
                </a>
                <a asp-action="Create" class="btn btn-primary px-4 fw-semibold shadow-sm">
                    Add Another Staff
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Toast notification for copy -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="copyToast" class="toast align-items-center text-white bg-dark border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body py-2" id="toastMessage">
                Copied to clipboard!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showToast(msg) {
            document.getElementById('toastMessage').innerText = msg;
            const toastEl = document.getElementById('copyToast');
            const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
            toast.show();
        }

        function copyToClipboard(inputId, label) {
            const copyText = document.getElementById(inputId);
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(copyText.value);
            showToast(`${label} copied to clipboard!`);
        }

        function copyFullSummary() {
            const summary = `Welcome to HMS, @Model.FullName!\n\nHere are your login credentials:\nRole: @Model.Role\nLogin URL: @Model.LoginUrl\nUsername: @Model.Email\nTemporary Password: @Model.TemporaryPassword\n\nPlease log in and change your password.`;
            navigator.clipboard.writeText(summary);
            showToast(`All credentials copied for sharing!`);
        }
    </script>
}
