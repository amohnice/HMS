@model HMS.Models.ViewModels.CreateUserViewModel
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Add New Staff Member";
    var roles = ViewBag.AvailableRoles as string[] ?? [];
}

<partial name="_SurfaceHead" model="@(new SurfaceHead { Title = "Add Staff Member" })" />

<div class="form-page">
    <a class="form-back btn btn-sm btn-secondary align-self-start" asp-action="Index">Back to staff list</a>

    <form class="form-card" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-field">
            <label asp-for="FullName" class="form-label">Full Name</label>
            <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" autofocus />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Email" class="form-label">Email Address</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="e.g. john@hms.local" />
            <span class="form-hint">This is the username they sign in with.</span>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Role" class="form-label">System Role</label>
            <select asp-for="Role" class="form-select">
                @foreach (var r in roles)
                {
                    <option value="@r">@r</option>
                }
            </select>
            <span class="form-hint">Decides which sections they can open.</span>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>

        <div class="form-review">
            <div class="form-check form-switch">
                @* data-reveal is handled in site.js so it also works inside the drawer. *@
                <input asp-for="AutoGeneratePassword" class="form-check-input" type="checkbox" checked
                       data-reveal="#customPasswordField" data-reveal-when="unchecked" />
                <label asp-for="AutoGeneratePassword" class="form-check-label">
                    Auto-generate a temporary password
                </label>
            </div>

            <div class="form-field mt-2" id="customPasswordField" hidden>
                <label asp-for="CustomPassword" class="form-label">Initial Password</label>
                <input asp-for="CustomPassword" type="password" class="form-control" placeholder="Enter initial password…" />
                <span asp-validation-for="CustomPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <a class="btn btn-secondary btn-sm" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary btn-sm">Create Account</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
