@model HMS.Models.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "Add New Staff Member";
    string[] roles = ViewBag.AvailableRoles as string[] ?? Array.Empty<string>();
}

<div class="container-fluid px-0" style="max-width: 700px;">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">Add New Staff Member</h1>
            <p class="text-muted small mb-0">Register a staff account and generate login credentials.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            Back to Staff List
        </a>
    </div>

    <!-- Main Form Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold text-dark">Full Name</label>
                    <input asp-for="FullName" class="form-control form-control-lg" placeholder="e.g. John Doe" autofocus />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-dark">Email Address (Username)</label>
                    <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="e.g. john@hms.local" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                    <div class="form-text">Staff will use this email address to log into HMS.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Role" class="form-label fw-semibold text-dark">Assign System Role</label>
                    <select asp-for="Role" class="form-select form-select-lg">
                        @foreach (var r in roles)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                    <div class="form-text">Determines system section access (e.g. Waiter, Kitchen, Cashier, Admin).</div>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4 border">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="AutoGeneratePassword" class="form-check-input" type="checkbox" id="autoPasswordSwitch" checked />
                        <label class="form-check-label fw-semibold text-dark" for="autoPasswordSwitch">Auto-generate secure temporary password</label>
                    </div>

                    <div id="customPasswordContainer" class="mt-3" style="display: none;">
                        <label asp-for="CustomPassword" class="form-label fw-semibold text-dark mb-1"></label>
                        <input asp-for="CustomPassword" type="password" class="form-control" placeholder="Enter initial password..." />
                        <span asp-validation-for="CustomPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2">
                    <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                        Create Account & Generate Link
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const autoSwitch = document.getElementById('autoPasswordSwitch');
        const customContainer = document.getElementById('customPasswordContainer');

        function togglePasswordInput() {
            if (autoSwitch.checked) {
                customContainer.style.display = 'none';
            } else {
                customContainer.style.display = 'block';
            }
        }

        autoSwitch?.addEventListener('change', togglePasswordInput);
        togglePasswordInput();
    </script>
}
