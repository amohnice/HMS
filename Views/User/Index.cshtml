@model IEnumerable<HMS.Models.User>
@{
    ViewData["Title"] = "Staff & Users Management";
    string currentRoleFilter = ViewBag.RoleFilter as string ?? "All";
    string currentSearch = ViewBag.Search as string ?? "";
    string[] roles = ViewBag.AvailableRoles as string[] ?? Array.Empty<string>();
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">Staff & Users Management</h1>
            <p class="text-muted small mb-0">Add system users, manage roles, and share initial login credentials.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold rounded-3 shadow-sm">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Add New Staff Member
            </a>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-7">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        </span>
                        <input type="text" name="search" id="searchInput" value="@currentSearch" class="form-control bg-light border-start-0 ps-0" placeholder="Type to filter staff by name or email..." autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-5 d-flex gap-2">
                    <select name="roleFilter" class="form-select bg-light" onchange="this.form.submit()">
                        @foreach (var r in roles)
                        {
                            <option value="@r" selected="@(r == currentRoleFilter ? "selected" : null)">@(r == "All" ? "All Roles" : r)</option>
                        }
                    </select>
                    @if (!string.IsNullOrEmpty(currentSearch) || currentRoleFilter != "All")
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 px-3 text-nowrap" title="Clear Filters">
                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            Clear
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="staffTable">
                    <thead class="bg-light border-bottom">
                        <tr>
                            <th class="ps-4 py-3 text-secondary text-uppercase fs-7 fw-bold">User</th>
                            <th class="py-3 text-secondary text-uppercase fs-7 fw-bold">Role</th>
                            <th class="py-3 text-secondary text-uppercase fs-7 fw-bold">Status</th>
                            <th class="py-3 text-secondary text-uppercase fs-7 fw-bold">Registered</th>
                            <th class="py-3 text-secondary text-uppercase fs-7 fw-bold">Last Login</th>
                            <th class="pe-4 py-3 text-end text-secondary text-uppercase fs-7 fw-bold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr id="emptyRow">
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mb-2 text-secondary opacity-50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                                    <p class="mb-0 fw-medium">No staff accounts found.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in Model)
                            {
                                string roleBadgeClass = user.Role switch
                                {
                                    "SuperAdmin" => "bg-danger text-white",
                                    "Admin" => "bg-dark text-white",
                                    "Manager" => "bg-primary text-white",
                                    "Waiter" => "bg-info text-dark",
                                    "Kitchen" => "bg-warning text-dark",
                                    "Cashier" => "bg-success text-white",
                                    "ShopCashier" => "bg-secondary text-white",
                                    _ => "bg-light text-dark"
                                };

                                <tr class="user-row" data-search-target="@(user.FullName.ToLower()) @(user.Email.ToLower()) @(user.Role.ToLower())">
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar-circle rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                @user.FullName.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-dark user-fullname">@user.FullName</div>
                                                <div class="text-muted small user-email">@user.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @roleBadgeClass px-2.5 py-1.5 rounded-pill fw-medium fs-7">@user.Role</span>
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1 rounded-pill">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@user.RegisteredAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-muted small">
                                        @(user.LastLoginAt.HasValue ? user.LastLoginAt.Value.ToString("MMM dd, yyyy HH:mm") : "Never")
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="dropdown d-inline-block">
                                            <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                Manage
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li>
                                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Edit" asp-route-id="@user.UserId">
                                                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                        Edit Staff Details
                                                    </a>
                                                </li>
                                                <li>
                                                    <form asp-action="ResetPassword" asp-route-id="@user.UserId" method="post" onsubmit="return confirm('Generate a new password for @user.FullName?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item text-warning d-flex align-items-center gap-2">
                                                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
                                                            Reset Password
                                                        </button>
                                                    </form>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-action="ToggleStatus" asp-route-id="@user.UserId" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item @(user.IsActive ? "text-danger" : "text-success") d-flex align-items-center gap-2">
                                                            @if (user.IsActive)
                                                            {
                                                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
                                                                <span>Deactivate Account</span>
                                                            }
                                                            else
                                                            {
                                                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                                                <span>Activate Account</span>
                                                            }
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                            <tr id="noMatchRow" style="display: none;">
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mb-2 text-secondary opacity-50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                                    <p class="mb-0 fw-medium">No staff accounts match your live search.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');
        const userRows = document.querySelectorAll('.user-row');
        const noMatchRow = document.getElementById('noMatchRow');

        function filterRows() {
            const query = searchInput.value.toLowerCase().trim();
            let visibleCount = 0;

            userRows.forEach(row => {
                const target = row.getAttribute('data-search-target') || '';
                if (target.includes(query)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (noMatchRow) {
                noMatchRow.style.display = (visibleCount === 0 && userRows.length > 0) ? '' : 'none';
            }
        }

        searchInput?.addEventListener('input', filterRows);
    </script>
}

