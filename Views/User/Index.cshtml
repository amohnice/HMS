@model HMS.Models.Common.PagedList<HMS.Models.User>
@using HMS.Models.ViewModels
@using HMS.Services.Ui
@{
    ViewData["Title"] = "Staff & Users";

    var currentRoleFilter = ViewBag.RoleFilter as string ?? "All";
    var currentSearch = ViewBag.Search as string ?? "";
    var roles = ViewBag.AvailableRoles as string[] ?? [];

    var head = new SurfaceHead
    {
        Title = "Staff & Users",
        Count = Model.TotalCount.ToString(),
        Search = new SurfaceSearch
        {
            Href = Url.Action("Index")!,
            Value = currentSearch,
            Placeholder = "Name or email…",
            Preserve = new() { ["roleFilter"] = currentRoleFilter }
        },
        Actions =
        [
            new SurfaceAction
            {
                Label = "Add Staff", Icon = "plus",
                Href = Url.Action("Create")!,
                Css = "btn btn-primary btn-sm",
                OpensDrawer = true, DrawerTitle = "New staff member"
            }
        ]
    };

    @* Role filtering by chip rather than a select buried in a filter card. *@
    var chips = roles.Select(r => new FilterChip
    {
        Label = r == "All" ? "All Roles" : r,
        Href = Url.Action("Index", new { search = currentSearch, roleFilter = r })!,
        IsActive = r == currentRoleFilter
    }).ToList();
}

<partial name="_SurfaceHead" model="head" />

@if (chips.Count > 0)
{
    <partial name="_FilterChips" model="chips" />
}

@if (!Model.Items.Any())
{
    <partial name="_EmptyState" model="@(new EmptyState
    {
        Icon = "users",
        Title = string.IsNullOrWhiteSpace(currentSearch) ? "No staff accounts yet" : $"Nothing matches “{currentSearch}”",
        Text = "Create an account so a staff member can sign in with their role.",
        Action = new SurfaceAction
        {
            Label = "Add Staff", Icon = "plus",
            Href = Url.Action("Create")!,
            OpensDrawer = true, DrawerTitle = "New staff member"
        }
    })" />
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover table-cards mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">User</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Registered</th>
                        <th>Last Login</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Items)
                    {
                        var activePill = StatusStyle.Availability(user.IsActive, "Active", "Inactive");

                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="row-avatar">@user.FullName[..1].ToUpper()</span>
                                    <span>
                                        <span class="d-block fw-semibold">@user.FullName</span>
                                        <span class="d-block text-muted small">@user.Email</span>
                                    </span>
                                </div>
                            </td>
                            <td data-label="Role">@user.Role</td>
                            <td data-label="Status">
                                <partial name="_StatusPill" model="activePill" />
                            </td>
                            <td data-label="Registered" class="text-muted small">@user.RegisteredAt.ToString("dd MMM yyyy")</td>
                            <td data-label="Last Login" class="text-muted small">
                                @(user.LastLoginAt?.ToString("dd MMM HH:mm") ?? "Never")
                            </td>
                            <td data-label="Actions" class="text-end">
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Manage
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" href="@Url.Action("Edit", new { id = user.UserId })"
                                               data-drawer data-drawer-title="Edit @user.FullName">Edit details</a>
                                        </li>
                                        <li>
                                            <form asp-action="ResetPassword" asp-route-id="@user.UserId" method="post"
                                                  onsubmit="return confirm('Generate a new password for @user.FullName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item">Reset password</button>
                                            </form>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="ToggleStatus" asp-route-id="@user.UserId" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item @(user.IsActive ? "text-danger" : "text-success")">
                                                    @(user.IsActive ? "Deactivate account" : "Activate account")
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model" />
    </div>
}
