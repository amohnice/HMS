@using HMS.Models.Shop
@using HMS.Models
@{
    ViewData["Title"] = "Shop POS Cashier";
    var products = (List<ShopProduct>)ViewBag.Products;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-0 fw-bold">Shop Point of Sale</h1>
        <p class="text-muted mb-0">Search items, scan barcodes, and process retail checkouts</p>
    </div>
    <div id="connectionStatus">
        <span class="badge bg-success py-1 px-3 fs-6">POS Terminal Online</span>
    </div>
</div>

<div class="pos-container">
    <!-- Catalog and Search (Left) -->
    <div>
        <!-- Search and Barcode Bar -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-sm-8 col-md-9">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                            </span>
                            <input type="text" id="barcodeSearchInput" class="form-control border-start-0 ps-0" placeholder="Scan Barcode (e.g. 100001) or Type Product Name..." onkeypress="handleSearchKeyPress(event)" />
                        </div>
                    </div>
                    <div class="col-sm-4 col-md-3">
                        <button type="button" class="btn btn-secondary w-100" onclick="performBarcodeLookup()">Add to Cart</button>
                    </div>
                </div>
                <div id="searchFeedback" class="text-danger small mt-1 d-none">Product not found or out of stock.</div>
            </div>
        </div>

        <!-- Quick Item Catalog -->
        <h5 class="fw-bold mb-3 text-secondary">Quick Select Catalog</h5>
        <div class="pos-menu-grid">
            @foreach (var p in products)
            {
                <div class="card menu-item-card" onclick="addToCart(@p.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.Name))', @p.Price, @p.StockQuantity)">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="badge bg-light text-secondary">@p.Category</span>
                            <span class="small text-muted">Stock: <strong>@p.StockQuantity</strong></span>
                        </div>
                        <h6 class="fw-bold mb-1 text-truncate">@p.Name</h6>
                        <span class="small text-muted d-block mb-2">Code: @p.Barcode</span>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-primary">Ksh @p.Price.ToString("N0")</span>
                            <span class="btn btn-sm btn-primary icon-action-btn">+</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- POS Cart Sidebar (Right) -->
    <div class="pos-cart-panel shadow-sm">
        <h5 class="fw-bold mb-3 border-bottom pb-2">Sales Cart</h5>

        <form id="checkoutForm" asp-action="Checkout" method="post" onsubmit="prepareCheckoutForm(event)">
            @Html.AntiForgeryToken()
            <div id="checkoutHiddenInputs"></div>

            <div class="pos-cart-items-header d-flex justify-content-between small fw-bold text-muted border-bottom pb-1 mb-2">
                <span>Item</span>
                <span>Qty/Price</span>
            </div>

            <!-- Items Container -->
            <div class="pos-cart-items" id="cartContainer">
                <div class="text-center text-muted py-5" id="emptyCartMessage">
                    Cart is empty. Scan barcodes or select catalog items to compile cart.
                </div>
            </div>

            <!-- Math and Settlement -->
            <div class="border-top pt-3 mt-auto">
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted mb-0 fw-bold">Discount (Ksh)</label>
                        <input name="discount" type="number" step="0.01" min="0" value="0" class="form-control form-control-sm" id="discountInput" oninput="calculateTotal()" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted mb-0 fw-bold">Tax (Ksh)</label>
                        <input name="tax" type="number" step="0.01" min="0" value="0" class="form-control form-control-sm" id="taxInput" oninput="calculateTotal()" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small text-muted mb-0 fw-bold">Payment Method</label>
                    <select name="paymentMethod" class="form-select form-select-sm" id="paymentMethodSelect">
                        @foreach (PaymentMethod method in Enum.GetValues(typeof(PaymentMethod)))
                        {
                            <option value="@method">@method</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small text-muted mb-0 fw-bold">Amount Tenders (Ksh)</label>
                    <input name="amountPaid" type="number" step="0.01" class="form-control form-control-sm fw-bold fs-6 text-success" id="amountPaidInput" oninput="calculateTotal()" required />
                </div>

                <div class="bg-light p-2 rounded mb-3 small d-flex justify-content-between">
                    <span class="text-muted">Subtotal:</span>
                    <span id="subTotalText" class="fw-bold">Ksh 0.00</span>
                </div>

                <div class="bg-light p-2 rounded mb-3 small d-flex justify-content-between border-start border-3 border-primary">
                    <div>
                        <span class="text-muted small d-block">CHANGE DUE</span>
                        <strong class="fs-5 text-dark" id="changeText">Ksh 0.00</strong>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary align-self-center py-0" onclick="exactPayment()">Exact Amount</button>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    <span class="fw-bold fs-5">TOTAL PAYABLE:</span>
                    <span class="fw-bold text-primary fs-4" id="totalPayableText">Ksh 0.00</span>
                </div>

                <button type="submit" class="btn btn-success w-100 btn-lg fw-bold" id="checkoutBtn" disabled>Process Checkout</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let cart = [];

        function handleSearchKeyPress(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                performBarcodeLookup();
            }
        }

        async function performBarcodeLookup() {
            const input = document.getElementById('barcodeSearchInput');
            const feedback = document.getElementById('searchFeedback');
            const query = input.value.trim();
            if (!query) return;

            feedback.style.display = 'none';

            let url = `@Url.Action("SearchProduct", "ShopCashier")?`;
            if (/^\d+$/.test(query)) {
                url += `barcode=${query}`;
            } else {
                url += `term=${encodeURIComponent(query)}`;
            }

            try {
                const response = await fetch(url);
                const result = await response.json();
                
                if (result.success) {
                    addToCart(result.id, result.name, result.price, result.stockQuantity);
                    input.value = '';
                    input.focus();
                } else {
                    feedback.style.display = 'block';
                }
            } catch (err) {
                console.error("Search failed:", err);
                feedback.style.display = 'block';
            }
        }

        function addToCart(id, name, price, stockQuantity) {
            const existing = cart.find(item => item.id === id);
            if (existing) {
                if (existing.qty < stockQuantity) {
                    existing.qty++;
                } else {
                    alert(`Cannot add more. Only ${stockQuantity} units available in stock.`);
                }
            } else {
                cart.push({ id, name, price, stockQuantity, qty: 1 });
            }
            renderCart();
        }

        function changeQty(id, delta) {
            const item = cart.find(item => item.id === id);
            if (item) {
                const newQty = item.qty + delta;
                if (newQty > item.stockQuantity) {
                    alert(`Cannot exceed available stock of ${item.stockQuantity} units.`);
                    return;
                }
                item.qty = newQty;
                if (item.qty <= 0) {
                    cart = cart.filter(x => x.id !== id);
                }
                renderCart();
            }
        }

        function renderCart() {
            const container = document.getElementById('cartContainer');
            const emptyMessage = document.getElementById('emptyCartMessage');
            
            if (cart.length === 0) {
                container.innerHTML = `<div class="text-center text-muted py-5" id="emptyCartMessage">Cart is empty. Scan barcodes or select catalog items to compile cart.</div>`;
                document.getElementById('checkoutBtn').disabled = true;
                resetMath();
                return;
            }

            container.innerHTML = '';
            cart.forEach(item => {
                const subtotal = item.price * item.qty;
                const itemDiv = document.createElement('div');
                itemDiv.className = 'pos-cart-item';
                itemDiv.innerHTML = `
                    <div class="cart-item-name">
                        <div class="fw-bold text-truncate small">${item.name}</div>
                        <div class="text-muted small">Ksh ${item.price.toFixed(2)}</div>
                    </div>
                    <div class="d-flex align-items-center">
                        <button type="button" class="btn btn-sm btn-outline-secondary p-1 py-0 me-2" onclick="changeQty(${item.id}, -1)">-</button>
                        <span class="fw-bold me-2 small cart-qty-pill">${item.qty}</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary p-1 py-0 me-2" onclick="changeQty(${item.id}, 1)">+</button>
                        <span class="fw-bold text-primary small">Ksh ${subtotal.toFixed(2)}</span>
                    </div>
                `;
                container.appendChild(itemDiv);
            });

            calculateTotal();
        }

        function calculateTotal() {
            let subtotal = 0;
            cart.forEach(item => {
                subtotal += item.price * item.qty;
            });

            const discount = parseFloat(document.getElementById('discountInput').value) || 0;
            const tax = parseFloat(document.getElementById('taxInput').value) || 0;
            const total = subtotal - discount + tax;

            document.getElementById('subTotalText').innerText = "Ksh " + subtotal.toFixed(2);
            document.getElementById('totalPayableText').innerText = "Ksh " + total.toFixed(2);

            const amtPaidInput = document.getElementById('amountPaidInput');
            
            // Auto preset paid amount if empty or lesser than total to guide the cashier
            if (!amtPaidInput.value || parseFloat(amtPaidInput.value) < total) {
                amtPaidInput.value = total.toFixed(2);
            }

            const paid = parseFloat(amtPaidInput.value) || 0;
            const change = paid - total;
            const changeText = document.getElementById('changeText');
            const checkoutBtn = document.getElementById('checkoutBtn');

            if (change >= 0) {
                changeText.innerText = "Ksh " + change.toFixed(2);
                changeText.classList.remove('text-danger');
                changeText.classList.add('text-success');
                checkoutBtn.disabled = false;
            } else {
                changeText.innerText = "Insufficient Amount";
                changeText.classList.remove('text-success');
                changeText.classList.add('text-danger');
                checkoutBtn.disabled = true;
            }
        }

        function exactPayment() {
            let subtotal = 0;
            cart.forEach(item => { subtotal += item.price * item.qty; });
            const discount = parseFloat(document.getElementById('discountInput').value) || 0;
            const tax = parseFloat(document.getElementById('taxInput').value) || 0;
            const total = subtotal - discount + tax;

            document.getElementById('amountPaidInput').value = total.toFixed(2);
            calculateTotal();
        }

        function resetMath() {
            document.getElementById('subTotalText').innerText = "Ksh 0.00";
            document.getElementById('totalPayableText').innerText = "Ksh 0.00";
            document.getElementById('amountPaidInput').value = "";
            document.getElementById('changeText').innerText = "Ksh 0.00";
            document.getElementById('discountInput').value = "0";
            document.getElementById('taxInput').value = "0";
        }

        function prepareCheckoutForm(event) {
            event.preventDefault();
            const form = document.getElementById('checkoutForm');
            const hiddenInputs = document.getElementById('checkoutHiddenInputs');
            hiddenInputs.innerHTML = '';

            cart.forEach(item => {
                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'productIds';
                idInput.value = item.id;
                hiddenInputs.appendChild(idInput);

                const qtyInput = document.createElement('input');
                qtyInput.type = 'hidden';
                qtyInput.name = 'quantities';
                qtyInput.value = item.qty;
                hiddenInputs.appendChild(qtyInput);
            });

            form.submit();
        }
    </script>
}
