@using HMS.Models.Shop
@using HMS.Models
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Shop POS";
    var products = (List<ShopProduct>)ViewBag.Products;
    var categories = products.Select(p => p.Category).Distinct().OrderBy(c => c).ToList();
}

<partial name="_SurfaceHead" model="@(new SurfaceHead
{
    Title = "Shop Till",
    Count = $"{products.Count} items"
})" />

<div class="pos-layout">

    @* ============ BROWSE ============ *@
    <div class="pos-browse">

        @* Barcode first: at a till the scanner is the primary input device. *@
        <div class="scan-bar">
            <span class="scan-bar-icon"><partial name="_Icon" model="@("search")" /></span>
            <input type="text" id="scanInput" autocomplete="off" autofocus
                   placeholder="Scan barcode or type a product name, then press Enter" />
            <button type="button" class="btn btn-primary btn-sm" id="scanAdd">Add</button>
        </div>
        <div class="scan-feedback" id="scanFeedback" hidden></div>

        <div class="chip-row" id="productFilters">
            <button type="button" class="chip is-active" data-filter="all">
                All
                <span class="chip-count">@products.Count</span>
            </button>
            @foreach (var category in categories)
            {
                <button type="button" class="chip" data-filter="@category">
                    @category
                    <span class="chip-count">@products.Count(p => p.Category == category)</span>
                </button>
            }
        </div>

        <div class="pos-menu-grid" id="productGrid">
            @foreach (var p in products)
            {
                <div class="dish-tile" data-dish="@p.Id" data-category="@p.Category"
                     data-name="@p.Name" data-max="@p.StockQuantity"
                     data-price="@p.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <div class="dish-tile-top">
                        <span class="dish-tile-kind">@p.Category</span>
                        <span class="dish-tile-stock">@p.StockQuantity left</span>
                    </div>
                    <span class="dish-tile-name">@p.Name</span>
                    @if (!string.IsNullOrWhiteSpace(p.Barcode))
                    {
                        <span class="dish-tile-code">@p.Barcode</span>
                    }

                    <div class="dish-tile-foot">
                        <span class="dish-tile-price">Ksh @p.Price.ToString("N0")</span>
                        <span class="stepper">
                            <button type="button" class="stepper-btn stepper-btn--sub" data-step="-1" aria-label="Remove one @p.Name">&minus;</button>
                            <span class="stepper-value" data-qty>0</span>
                            <button type="button" class="stepper-btn stepper-btn--add" data-step="1" aria-label="Add one @p.Name">+</button>
                        </span>
                    </div>
                </div>
            }
        </div>

        @if (products.Count == 0)
        {
            <partial name="_EmptyState" model="@(new EmptyState
            {
                Icon = "box",
                Title = "Nothing in stock to sell",
                Text = "Add products, or restock existing ones, before taking sales."
            })" />
        }
    </div>

    @* ============ CART RAIL ============ *@
    <form class="cart-rail" id="checkoutForm" asp-action="Checkout" method="post">
        @Html.AntiForgeryToken()
        <div id="cartInputs"></div>
        <input type="hidden" name="paymentMethod" id="paymentMethod" value="Cash" />

        <div class="cart-head">
            <div class="cart-head-row">
                <div>
                    <h2 class="cart-head-title">Sale</h2>
                    <span class="cart-head-meta" id="saleMeta">Walk-in</span>
                </div>
                <div class="cart-head-actions">
                    <button type="button" class="cart-icon-btn cart-icon-btn--danger" id="cartClear" title="Clear sale">
                        <partial name="_Icon" model="@("refresh")" />
                    </button>
                </div>
            </div>
        </div>

        <hr class="cart-rule" />

        <div class="cart-items">
            <div class="cart-section-head">
                <span>Items</span>
                <span class="cart-section-count" id="cartCount">00</span>
            </div>
            <div id="cartLines">
                <div class="cart-empty">Scan or tap an item.</div>
            </div>
        </div>

        <hr class="cart-rule" />

        <div class="cart-summary">
            <div class="cart-summary-row">
                <span>Subtotal</span>
                <span id="subTotal">Ksh 0</span>
            </div>

            <div class="cart-summary-row cart-adjust">
                <label for="discountInput">Discount</label>
                <input name="discount" id="discountInput" type="number" step="0.01" min="0" value="0" />
            </div>
            <div class="cart-summary-row cart-adjust">
                <label for="taxInput">Tax</label>
                <input name="tax" id="taxInput" type="number" step="0.01" min="0" value="0" />
            </div>

            <div class="cart-summary-row cart-summary-row--total">
                <span>Total Payable</span>
                <span id="totalPayable">Ksh 0</span>
            </div>

            <div class="cart-summary-row cart-adjust">
                <label for="amountPaidInput">Tendered</label>
                <input name="amountPaid" id="amountPaidInput" type="number" step="0.01" required />
            </div>
            <div class="cart-summary-row cart-change" id="changeRow">
                <span>Change due</span>
                <span id="changeText">Ksh 0</span>
            </div>
        </div>

        @* Payment method as a segmented row rather than a dropdown. *@
        <div class="cart-methods" id="methodRow">
            @foreach (var method in Enum.GetValues<PaymentMethod>())
            {
                <button type="button" class="cart-method @(method == PaymentMethod.Cash ? "is-active" : "")" data-method="@method">
                    @method
                </button>
            }
        </div>

        <div class="cart-foot">
            <button type="button" class="btn btn-secondary btn-sm" id="exactBtn">Exact</button>
            <button type="submit" class="btn btn-primary btn-sm" id="checkoutBtn" disabled>Checkout</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    var grid   = document.getElementById('productGrid');
    var form   = document.getElementById('checkoutForm');
    var lines  = document.getElementById('cartLines');
    var inputs = document.getElementById('cartInputs');

    var discountEl = document.getElementById('discountInput');
    var taxEl      = document.getElementById('taxInput');
    var paidEl     = document.getElementById('amountPaidInput');
    var feedback   = document.getElementById('scanFeedback');

    // qty by product id. Tiles own the editing; this is the projection.
    var cart = {};
    // True once the cashier types a tendered amount, so recalculation stops
    // overwriting what they entered.
    var paidTouched = false;

    function money(n) {
        return 'Ksh ' + n.toLocaleString('en-KE', { maximumFractionDigits: 0 });
    }

    function tileOf(id) { return grid.querySelector('[data-dish="' + id + '"]'); }

    function say(message) {
        if (!message) { feedback.hidden = true; return; }
        feedback.textContent = message;
        feedback.hidden = false;
        clearTimeout(say._t);
        say._t = setTimeout(function () { feedback.hidden = true; }, 3000);
    }

    function setQty(tile, wanted) {
        if (!tile) return;
        var id  = tile.getAttribute('data-dish');
        var max = parseInt(tile.getAttribute('data-max'), 10);
        var qty = wanted;

        if (qty > max) {
            qty = max;
            say('Only ' + max + ' of ' + tile.getAttribute('data-name') + ' in stock.');
        }
        if (qty < 0) qty = 0;

        if (qty === 0) {
            delete cart[id];
        } else {
            cart[id] = {
                name: tile.getAttribute('data-name'),
                price: parseFloat(tile.getAttribute('data-price')),
                qty: qty
            };
        }

        tile.querySelector('[data-qty]').textContent = qty;
        tile.classList.toggle('is-selected', qty > 0);
        render();
    }

    function subtotalOf() {
        return Object.keys(cart).reduce(function (sum, id) {
            return sum + cart[id].price * cart[id].qty;
        }, 0);
    }

    function totalOf() {
        var discount = parseFloat(discountEl.value) || 0;
        var tax = parseFloat(taxEl.value) || 0;
        return Math.max(0, subtotalOf() - discount + tax);
    }

    function render() {
        var ids = Object.keys(cart);

        if (ids.length === 0) {
            lines.innerHTML = '<div class="cart-empty">Scan or tap an item.</div>';
        } else {
            lines.innerHTML = '';
            ids.forEach(function (id) {
                var line = cart[id];
                var row = document.createElement('div');
                row.className = 'cart-line';
                row.innerHTML =
                    '<span class="cart-line-qty">' + line.qty + '&times;</span>' +
                    '<span class="cart-line-name"></span>' +
                    '<span class="cart-line-amount">' + money(line.price * line.qty) + '</span>' +
                    '<button type="button" class="cart-line-drop" data-drop="' + id + '" aria-label="Remove">&times;</button>';
                row.querySelector('.cart-line-name').textContent = line.name;
                lines.appendChild(row);
            });
        }

        document.getElementById('cartCount').textContent = ('0' + ids.length).slice(-2);
        recalc();
    }

    function recalc() {
        var total = totalOf();

        document.getElementById('subTotal').textContent = money(subtotalOf());
        document.getElementById('totalPayable').textContent = money(total);

        // Prefill the tendered box until the cashier types their own figure.
        if (!paidTouched) paidEl.value = total > 0 ? total.toFixed(2) : '';

        var paid = parseFloat(paidEl.value) || 0;
        var change = paid - total;
        var row = document.getElementById('changeRow');
        var short = change < 0;

        document.getElementById('changeText').textContent = short ? 'Short ' + money(-change) : money(change);
        row.classList.toggle('is-short', short);

        document.getElementById('checkoutBtn').disabled = Object.keys(cart).length === 0 || short || total <= 0;
    }

    // --- Steppers ---
    grid?.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-step]');
        if (!btn) return;
        var tile = btn.closest('[data-dish]');
        var current = parseInt(tile.querySelector('[data-qty]').textContent, 10) || 0;
        setQty(tile, current + parseInt(btn.getAttribute('data-step'), 10));
    });

    lines.addEventListener('click', function (e) {
        var drop = e.target.closest('[data-drop]');
        if (drop) setQty(tileOf(drop.getAttribute('data-drop')), 0);
    });

    // --- Category filter ---
    document.getElementById('productFilters')?.addEventListener('click', function (e) {
        var chip = e.target.closest('[data-filter]');
        if (!chip) return;
        var want = chip.getAttribute('data-filter');
        this.querySelectorAll('[data-filter]').forEach(function (c) {
            c.classList.toggle('is-active', c === chip);
        });
        grid.querySelectorAll('[data-dish]').forEach(function (tile) {
            tile.hidden = want !== 'all' && tile.getAttribute('data-category') !== want;
        });
    });

    // --- Barcode / name lookup ---
    var scanInput = document.getElementById('scanInput');

    function lookup() {
        var query = scanInput.value.trim();
        if (!query) return;

        // A tile already on screen is the fast path — no round trip needed.
        var local = grid.querySelector('[data-dish][data-name="' + query.replace(/"/g, '\\"') + '"]');
        if (local) {
            bump(local);
            scanInput.value = '';
            return;
        }

        var url = '@Url.Action("SearchProduct", "ShopCashier")?' +
            (/^\d+$/.test(query) ? 'barcode=' + encodeURIComponent(query)
                                 : 'term=' + encodeURIComponent(query));

        fetch(url, { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (result) {
                if (!result.success) { say('No product matches “' + query + '”.'); return; }
                var tile = tileOf(result.id);
                if (tile) {
                    bump(tile);
                } else {
                    // In the catalogue but filtered out of view (e.g. inactive tile).
                    say(result.name + ' is not on the quick grid — search the catalogue.');
                }
                scanInput.value = '';
                scanInput.focus();
            })
            .catch(function () { say('Lookup failed. Check the connection and try again.'); });
    }

    function bump(tile) {
        var current = parseInt(tile.querySelector('[data-qty]').textContent, 10) || 0;
        setQty(tile, current + 1);
    }

    scanInput?.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); lookup(); }
    });
    document.getElementById('scanAdd')?.addEventListener('click', lookup);

    // --- Money inputs ---
    discountEl.addEventListener('input', function () { paidTouched = false; recalc(); });
    taxEl.addEventListener('input', function () { paidTouched = false; recalc(); });
    paidEl.addEventListener('input', function () { paidTouched = true; recalc(); });

    document.getElementById('exactBtn')?.addEventListener('click', function () {
        paidTouched = false;
        recalc();
        paidEl.focus();
    });

    // --- Payment method ---
    document.getElementById('methodRow')?.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-method]');
        if (!btn) return;
        this.querySelectorAll('[data-method]').forEach(function (b) {
            b.classList.toggle('is-active', b === btn);
        });
        document.getElementById('paymentMethod').value = btn.getAttribute('data-method');
    });

    // --- Clear ---
    document.getElementById('cartClear')?.addEventListener('click', function () {
        Object.keys(cart).forEach(function (id) {
            var tile = tileOf(id);
            if (tile) {
                tile.querySelector('[data-qty]').textContent = '0';
                tile.classList.remove('is-selected');
            }
        });
        cart = {};
        discountEl.value = '0';
        taxEl.value = '0';
        paidTouched = false;
        render();
        scanInput?.focus();
    });

    // --- Submit ---
    form.addEventListener('submit', function (e) {
        if (Object.keys(cart).length === 0) { e.preventDefault(); return; }
        inputs.innerHTML = '';
        Object.keys(cart).forEach(function (id) {
            inputs.insertAdjacentHTML('beforeend',
                '<input type="hidden" name="productIds" value="' + id + '">' +
                '<input type="hidden" name="quantities" value="' + cart[id].qty + '">');
        });
    });

    render();
})();
</script>
}
