@model IEnumerable<HMS.Models.Restaurant.RestaurantOrder>
@using HMS.Models
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Kitchen Screen";

    var orders = Model.ToList();

    @* Next state for each card's single action — the board is one decision per ticket. *@
    static (RestaurantOrderStatus? Next, string Label) Advance(RestaurantOrderStatus status) => status switch
    {
        RestaurantOrderStatus.Pending   => (RestaurantOrderStatus.Preparing, "Start Preparing"),
        RestaurantOrderStatus.Preparing => (RestaurantOrderStatus.Ready, "Mark as Ready"),
        RestaurantOrderStatus.Ready     => (RestaurantOrderStatus.Served, "Mark as Served"),
        _                               => (null, "Awaiting cashier")
    };
}

@* Live counters and clock sit in the top bar — they used to be the KDS bar's job. *@
@section TopBarTools {
    <span class="kds-stat-chip pending">Pending <strong id="kdsPendingCount">—</strong></span>
    <span class="kds-stat-chip preparing">Preparing <strong id="kdsPreparingCount">—</strong></span>
    <span class="kds-stat-chip ready">Ready <strong id="kdsReadyCount">—</strong></span>
    <span class="kds-clock" id="kdsClock"></span>
}

<div class="surface-head">
    <h1 class="surface-title">Kitchen Display <span class="surface-count">(@orders.Count)</span></h1>
    <div class="surface-head-actions">
        <button class="btn btn-secondary btn-sm" type="button" onclick="location.reload()">Refresh</button>
    </div>
</div>

@if (orders.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyState
    {
        Icon = "chef",
        Title = "Kitchen caught up",
        Text = "New tickets appear here the moment waiters send them."
    })" />
}
else
{
    <div class="ticket-grid">
        @foreach (var order in orders)
        {
            var state = order.Status.ToString().ToLower();
            var advance = Advance(order.Status);
            var elapsed = (int)(DateTime.Now - order.OrderTime).TotalMinutes;

            <article class="ticket ticket--@state" data-kds-status="@order.Status">
                <header class="ticket-head">
                    <span class="ticket-id">#@order.Id.ToString("D4")</span>
                    <span class="ticket-table">Table @order.Table.TableNumber</span>
                    <span class="ticket-age">@(elapsed <= 0 ? "just now" : $"{elapsed}m")</span>
                </header>

                <div class="ticket-meta">
                    <span>@order.Waiter.FullName</span>
                    <span>@(string.IsNullOrWhiteSpace(order.CustomerName) ? "Guest" : order.CustomerName)</span>
                </div>

                <ul class="ticket-lines">
                    @foreach (var item in order.Items)
                    {
                        <li>
                            <span class="ticket-qty">@item.Quantity&times;</span>
                            <span class="ticket-item">@item.MenuItem.Name</span>
                            <span class="ticket-cat">@item.MenuItem.Category</span>
                        </li>
                    }
                </ul>

                @if (!string.IsNullOrWhiteSpace(order.Notes))
                {
                    <p class="ticket-note"><strong>Notes:</strong> @order.Notes</p>
                }

                <form class="ticket-action" asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@order.Id" />
                    @if (advance.Next is not null)
                    {
                        <input type="hidden" name="status" value="@advance.Next" />
                        <button type="submit" class="btn btn-primary w-100">@advance.Label</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary w-100" disabled>@advance.Label</button>
                    }
                </form>
            </article>
        }
    </div>
}
