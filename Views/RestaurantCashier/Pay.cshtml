@model HMS.Models.Restaurant.RestaurantOrder
@using HMS.Models
@using HMS.Models.ViewModels
@using HMS.Services.Ui
@{
    ViewData["Title"] = "Collect Payment";
    var total = Model.TotalAmount;
}

<partial name="_SurfaceHead" model="@(new SurfaceHead
{
    Title = $"Order #{Model.Id:D4}",
    Actions =
    [
        new SurfaceAction { Label = "Back to till", Href = Url.Action("Index")!, Css = "btn btn-secondary btn-sm" }
    ]
})" />

<div class="pos-layout">

    @* ---------- The bill ---------- *@
    <div class="pos-browse">
        <section class="card bill">
            <header class="bill-head">
                <div>
                    <h2 class="bill-title">Table @(Model.Table?.TableNumber ?? "—")</h2>
                    <span class="bill-meta">
                        @(string.IsNullOrWhiteSpace(Model.CustomerName) ? "Guest" : Model.CustomerName)
                        · served by @(Model.Waiter?.FullName ?? "—")
                        · @Model.OrderTime.ToString("dd MMM HH:mm")
                    </span>
                </div>
                <partial name="_StatusPill" model="StatusStyle.From(Model.Status)" />
            </header>

            <div class="bill-lines">
                @foreach (var item in Model.Items)
                {
                    <div class="bill-line">
                        <span class="bill-line-qty">@item.Quantity&times;</span>
                        <span class="bill-line-name">@item.MenuItem.Name</span>
                        <span class="bill-line-unit">@@ Ksh @item.UnitPrice.ToString("N0")</span>
                        <span class="bill-line-amount">Ksh @item.LineTotal.ToString("N0")</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <p class="bill-note"><strong>Notes:</strong> @Model.Notes</p>
            }

            <footer class="bill-total">
                <span>Total Due</span>
                <span>Ksh @total.ToString("N0")</span>
            </footer>
        </section>
    </div>

    @* ---------- Settlement ---------- *@
    <form class="cart-rail" asp-action="Pay" method="post" id="payForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="paymentMethod" id="paymentMethod" value="@PaymentMethod.Cash" />

        <div class="cart-head">
            <div class="cart-head-row">
                <div>
                    <h2 class="cart-head-title">Take Payment</h2>
                    <span class="cart-head-meta">@Model.Items.Sum(i => i.Quantity) items</span>
                </div>
            </div>
        </div>

        <hr class="cart-rule" />

        <div class="cart-summary">
            <div class="cart-summary-row cart-summary-row--total">
                <span>Total Payable</span>
                <span>Ksh @total.ToString("N0")</span>
            </div>

            <div class="cart-summary-row cart-adjust">
                <label for="amountPaidInput">Tendered</label>
                <input name="amountPaid" id="amountPaidInput" type="number" step="0.01" min="0"
                       value="@total.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" required />
            </div>

            <div class="cart-summary-row cart-change" id="changeRow">
                <span>Change due</span>
                <span id="changeText">Ksh 0</span>
            </div>
        </div>

        <div class="cart-methods" id="methodRow">
            @foreach (var method in Enum.GetValues<PaymentMethod>())
            {
                <button type="button" class="cart-method @(method == PaymentMethod.Cash ? "is-active" : "")" data-method="@method">
                    @method
                </button>
            }
        </div>

        <div class="cart-foot">
            <button type="button" class="btn btn-secondary btn-sm" id="exactBtn">Exact</button>
            <button type="submit" class="btn btn-primary btn-sm" id="payBtn">Complete Sale</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    var total  = @total.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var paidEl = document.getElementById('amountPaidInput');
    var row    = document.getElementById('changeRow');
    var text   = document.getElementById('changeText');
    var payBtn = document.getElementById('payBtn');

    function money(n) {
        return 'Ksh ' + n.toLocaleString('en-KE', { maximumFractionDigits: 0 });
    }

    function recalc() {
        var change = (parseFloat(paidEl.value) || 0) - total;
        var short = change < 0;

        text.textContent = short ? 'Short ' + money(-change) : money(change);
        row.classList.toggle('is-short', short);
        payBtn.disabled = short;
    }

    paidEl.addEventListener('input', recalc);

    document.getElementById('exactBtn').addEventListener('click', function () {
        paidEl.value = total;
        recalc();
        paidEl.focus();
    });

    document.getElementById('methodRow').addEventListener('click', function (e) {
        var btn = e.target.closest('[data-method]');
        if (!btn) return;
        this.querySelectorAll('[data-method]').forEach(function (b) {
            b.classList.toggle('is-active', b === btn);
        });
        document.getElementById('paymentMethod').value = btn.getAttribute('data-method');
    });

    recalc();
})();
</script>
}
