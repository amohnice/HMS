@model HMS.Models.Restaurant.RestaurantOrder
@{
    ViewData["Title"] = "Order Receipt";
}

@* Screen-only chrome; the receipt below is what actually prints. *@
<div class="surface-head d-print-none">
    <h1 class="surface-title">Receipt <span class="surface-count">#R-@Model.Id</span></h1>
    <div class="surface-head-actions">
        <a class="btn btn-secondary btn-sm" asp-action="Index">Back to till</a>
        <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">Print</button>
    </div>
</div>

<div class="receipt-container">
    <div class="receipt-header">
        <h5 class="fw-bold mb-0">AMTECH HMS</h5>
        <span class="small d-block">RESTAURANT RECEIPT</span>
        <span class="small text-muted">Tel: +254 700 000000</span>
    </div>

    <div class="receipt-row">
        <span>Receipt No:</span>
        <span class="fw-bold">#R-@Model.Id</span>
    </div>
    <div class="receipt-row">
        <span>Date:</span>
        <span>@Model.PaidAt?.ToString("yyyy-MM-dd HH:mm")</span>
    </div>
    <div class="receipt-row">
        <span>Table:</span>
        <span>Table @Model.Table.TableNumber</span>
    </div>
    <div class="receipt-row">
        <span>Cashier:</span>
        <span>@Model.Waiter.FullName</span>
    </div>
    <div class="receipt-row mb-1">
        <span>Customer:</span>
        <span>@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "Guest" : Model.CustomerName)</span>
    </div>

    <div class="receipt-divider"></div>

    <div class="fw-bold receipt-row mb-2">
        <span>Item Description</span>
        <span>Total</span>
    </div>

    @foreach (var item in Model.Items)
    {
        <div class="receipt-row">
            <span>@item.MenuItem.Name</span>
            <span>Ksh @item.LineTotal.ToString("N0")</span>
        </div>
        <div class="receipt-row text-muted small" style="margin-top: -3px; font-size: 0.8rem;">
            <span>@item.Quantity @(item.Quantity == 1 ? "unit" : "units") &times; Ksh @item.UnitPrice.ToString("N0")</span>
        </div>
    }

    <div class="receipt-divider"></div>

    <div class="receipt-row fw-bold fs-6">
        <span>TOTAL DUE</span>
        <span>Ksh @Model.TotalAmount.ToString("N2")</span>
    </div>

    <div class="receipt-row">
        <span>Amount Paid (@Model.PaymentMethod)</span>
        <span>Ksh @Model.AmountPaid?.ToString("N2")</span>
    </div>

    <div class="receipt-row">
        <span>Change Returned</span>
        <span>Ksh @Model.ChangeAmount?.ToString("N2")</span>
    </div>

    <div class="receipt-divider"></div>

    <div class="text-center small mt-3">
        <strong>Thank You for Dining With Us!</strong><br />
        <span>Please come again!</span>
    </div>
</div>
