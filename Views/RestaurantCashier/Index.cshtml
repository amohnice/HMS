@model IEnumerable<HMS.Models.Restaurant.RestaurantOrder>
@{
    ViewData["Title"] = "Restaurant Cashier POS";
}

<div class="mb-4">
    <h1 class="h2 mb-0 fw-bold">Restaurant Cashier</h1>
    <p class="text-muted">Process payments, checkout tables, and print receipts</p>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0 fw-bold">Orders Awaiting Payment</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Order ID</th>
                    <th>Table</th>
                    <th>Customer Name</th>
                    <th>Waiter</th>
                    <th>Time Served</th>
                    <th class="text-end">Amount Due</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <svg class="mb-3 text-success" width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <p class="mb-0">No orders awaiting payment. All served orders have been checked out.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var order in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#@order.Id</td>
                            <td><span class="badge bg-secondary">Table @order.Table.TableNumber</span></td>
                            <td>@(string.IsNullOrWhiteSpace(order.CustomerName) ? "Guest" : order.CustomerName)</td>
                            <td>@order.Waiter.FullName</td>
                            <td>@order.OrderTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end fw-bold text-primary">Ksh @order.TotalAmount.ToString("N2")</td>
                            <td class="text-center">
                                <a asp-action="Pay" asp-route-id="@order.Id" class="btn btn-sm btn-primary py-1 px-3">Process Payment</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
