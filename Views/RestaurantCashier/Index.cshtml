@model IEnumerable<HMS.Models.Restaurant.RestaurantOrder>
@using HMS.Models.ViewModels
@using HMS.Services.Ui
@{
    ViewData["Title"] = "Restaurant Cashier";

    var orders = Model.ToList();
    var due = orders.Sum(o => o.TotalAmount);
}

<partial name="_SurfaceHead" model="@(new SurfaceHead
{
    Title = "Awaiting Payment",
    Count = orders.Count.ToString()
})" />

@if (orders.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyState
    {
        Icon = "card",
        Title = "Everything is settled",
        Text = "Served orders appear here the moment a waiter marks them served."
    })" />
}
else
{
    <div class="kpi-strip">
        <div class="kpi">
            <span class="kpi-label">Tables to settle</span>
            <span class="kpi-value">@orders.Count</span>
        </div>
        <div class="kpi">
            <span class="kpi-label">Total due</span>
            <span class="kpi-value">Ksh @due.ToString("N0")</span>
        </div>
        <div class="kpi">
            <span class="kpi-label">Longest waiting</span>
            <span class="kpi-value">@((int)(DateTime.Now - orders.Min(o => o.OrderTime)).TotalMinutes)m</span>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover table-cards mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Order</th>
                        <th>Table</th>
                        <th>Customer</th>
                        <th>Waiter</th>
                        <th>Ordered</th>
                        <th>Status</th>
                        <th class="text-end">Amount Due</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in orders)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#@order.Id.ToString("D4")</td>
                            <td data-label="Table">Table @order.Table.TableNumber</td>
                            <td data-label="Customer">@(string.IsNullOrWhiteSpace(order.CustomerName) ? "Guest" : order.CustomerName)</td>
                            <td data-label="Waiter">@order.Waiter.FullName</td>
                            <td data-label="Ordered">@order.OrderTime.ToString("dd MMM HH:mm")</td>
                            <td data-label="Status"><partial name="_StatusPill" model="StatusStyle.From(order.Status)" /></td>
                            <td data-label="Amount Due" class="text-end fw-bold">Ksh @order.TotalAmount.ToString("N0")</td>
                            <td data-label="Action" class="text-center">
                                <a class="btn btn-sm btn-primary" asp-action="Pay" asp-route-id="@order.Id">Take Payment</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
