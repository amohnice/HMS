@model HMS.Models.Restaurant.RestaurantMenu
@{
    ViewData["Title"] = "Delete Menu Item";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-sm btn-secondary me-3">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            </a>
            <h1 class="h3 mb-0 fw-bold">Delete Menu Item</h1>
        </div>

        <div class="card border-danger shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <svg class="text-danger mb-2" width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    <h4 class="fw-bold">Are you sure you want to delete this menu item?</h4>
                    <p class="text-muted">This action cannot be undone. Order records referencing this item will be retained but the menu item itself will no longer exist.</p>
                </div>

                <div class="bg-light p-3 rounded mb-4">
                    <div class="row">
                        <div class="col-4 text-muted fw-bold">Name:</div>
                        <div class="col-8 fw-semibold">@Model.Name</div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-4 text-muted fw-bold">Category:</div>
                        <div class="col-8">@Model.Category</div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-4 text-muted fw-bold">Price:</div>
                        <div class="col-8 fw-bold text-primary">Ksh @Model.Price.ToString("N2")</div>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg">Delete Menu Item</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
