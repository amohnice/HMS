@model HMS.Models.Restaurant.RestaurantMenu
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Delete Menu Item";
}

<partial name="_SurfaceHead" model="@(new SurfaceHead { Title = "Delete Menu Item" })" />

<div class="form-page">
    <a class="form-back btn btn-sm btn-secondary align-self-start" asp-action="Index">Back to menu</a>

    <form class="form-card" asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="form-warning">
            <span>
                Deleting <strong>@Model.Name</strong> cannot be undone. Past orders that
                reference it keep their records, but the item leaves the menu.
            </span>
        </div>

        <dl class="form-review">
            <div class="form-review-row"><dt>Name</dt><dd>@Model.Name</dd></div>
            <div class="form-review-row"><dt>Category</dt><dd>@Model.Category</dd></div>
            <div class="form-review-row"><dt>Price</dt><dd>Ksh @Model.Price.ToString("N0")</dd></div>
        </dl>

        <div class="form-actions">
            <a class="btn btn-secondary btn-sm" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-danger btn-sm">Delete Item</button>
        </div>
    </form>
</div>
