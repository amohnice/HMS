@model HMS.Models.Common.PagedList<HMS.Models.Restaurant.RestaurantMenu>
@using HMS.Models
@using HMS.Models.ViewModels
@using HMS.Services.Ui
@{
    ViewData["Title"] = "Restaurant Menu";

    var search = ViewBag.Search as string;
    var active = ViewBag.CategoryFilter as RestaurantMenuCategory?;
    var counts = ViewBag.CategoryCounts as Dictionary<RestaurantMenuCategory, int> ?? [];

    string CategoryUrl(RestaurantMenuCategory? category) => Url.Action("Index", new { search, category })!;

    var column = new ContextColumn
    {
        Title = "Categories",
        Items =
        [
            new ContextItem
            {
                Label = "All Items", Icon = "book",
                Count = counts.Values.Sum(),
                Href = CategoryUrl(null),
                IsActive = active is null
            }
        ],
        Foot = new SurfaceAction
        {
            Label = "Add Menu Item", Icon = "plus",
            Href = Url.Action("Create")!,
            Css = "btn btn-primary btn-sm w-100",
            OpensDrawer = true, DrawerTitle = "New menu item"
        }
    };

    foreach (var category in Enum.GetValues<RestaurantMenuCategory>())
    {
        column.Items.Add(new ContextItem
        {
            Label = category.ToString(),
            Count = counts.TryGetValue(category, out var n) ? n : 0,
            Href = CategoryUrl(category),
            IsActive = active == category
        });
    }

    var head = new SurfaceHead
    {
        Title = active?.ToString() ?? "All Dishes",
        Count = Model.TotalCount.ToString(),
        ShowViewToggle = Model.Items.Any(),
        Search = new SurfaceSearch
        {
            Href = Url.Action("Index")!,
            Value = search,
            Placeholder = "Search dishes…",
            Preserve = new() { ["category"] = active?.ToString() }
        }
    };
}

@section ContextColumn {
    <partial name="_ContextColumn" model="column" />
}

<partial name="_SurfaceHead" model="head" />

@if (!Model.Items.Any())
{
    <partial name="_EmptyState" model="@(new EmptyState
    {
        Icon = "book",
        Title = string.IsNullOrWhiteSpace(search)
            ? "No dishes in this category yet"
            : $"Nothing matches “{search}”",
        Text = "Add a dish, or pick another category from the left.",
        Action = new SurfaceAction
        {
            Label = "Add Menu Item", Icon = "plus",
            Href = Url.Action("Create")!,
            OpensDrawer = true, DrawerTitle = "New menu item"
        }
    })" />
}
else
{
    <div data-view-host data-view="grid">

        @* ---------------- GRID ---------------- *@
        <div data-view-pane="grid">
            <div class="card-grid">
                @* Creation happens in place — the common case never leaves the page. *@
                <a class="add-tile" href="@Url.Action("Create")" data-drawer data-drawer-title="New menu item">
                    <span class="add-tile-mark"><partial name="_Icon" model="@("plus")" /></span>
                    Add New Dish@(active is null ? "" : $" to {active}")
                </a>

                @foreach (var item in Model.Items)
                {
                    <div class="entity-card">
                        <div class="entity-card-top">
                            <span class="entity-card-kind">@item.Category</span>
                            <partial name="_StatusPill" model="StatusStyle.Availability(item.IsAvailable)" />
                        </div>

                        <div class="entity-card-title">@item.Name</div>
                        <div class="entity-card-desc">
                            @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)
                        </div>

                        <div class="entity-card-foot">
                            <span class="entity-card-price">Ksh @item.Price.ToString("N0")</span>
                            <span class="btn-group">
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = item.Id })"
                                   data-drawer data-drawer-title="Edit @item.Name">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" href="@Url.Action("Delete", new { id = item.Id })"
                                   data-drawer data-drawer-title="Delete @item.Name">Delete</a>
                            </span>
                        </div>
                    </div>
                }
            </div>

            <div class="card mt-3">
                <partial name="_Pagination" model="Model" />
            </div>
        </div>

        @* ---------------- LIST ---------------- *@
        <div data-view-pane="list">
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover table-cards mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Name</th>
                                <th>Category</th>
                                <th class="text-end">Price</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@item.Name</td>
                                    <td data-label="Category">@item.Category</td>
                                    <td data-label="Price" class="text-end">Ksh @item.Price.ToString("N0")</td>
                                    <td data-label="Status">
                                        <partial name="_StatusPill" model="StatusStyle.Availability(item.IsAvailable)" />
                                    </td>
                                    <td data-label="Actions" class="text-center">
                                        <div class="btn-group">
                                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = item.Id })"
                                               data-drawer data-drawer-title="Edit @item.Name">Edit</a>
                                            <a class="btn btn-sm btn-outline-danger" href="@Url.Action("Delete", new { id = item.Id })"
                                               data-drawer data-drawer-title="Delete @item.Name">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pagination" model="Model" />
            </div>
        </div>
    </div>
}
