@model HMS.Models.Restaurant.RestaurantMenu
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Add Menu Item";
}

@* .surface-head is stripped when this page is lifted into the drawer,
   which supplies its own header. *@
<partial name="_SurfaceHead" model="@(new SurfaceHead { Title = "Add Menu Item" })" />

<div class="form-page">
    <a class="form-back btn btn-sm btn-secondary align-self-start" asp-action="Index">Back to menu</a>

    <form class="form-card" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-field">
            <label asp-for="Name" class="form-label">Item Name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Grilled Chicken" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Category" class="form-label">Category</label>
                <select asp-for="Category" asp-items="Html.GetEnumSelectList<HMS.Models.RestaurantMenuCategory>()" class="form-select" required></select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="Price" class="form-label">Price</label>
                <div class="input-group">
                    <span class="input-group-text">Ksh</span>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                </div>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Ingredients, portion size…"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="ImageUrl" class="form-label">Image URL</label>
            <input asp-for="ImageUrl" class="form-control" placeholder="/images/food/chicken.jpg" />
            <span class="form-hint">Optional.</span>
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>

        <div class="form-check form-switch">
            <input asp-for="IsAvailable" class="form-check-input" type="checkbox" checked />
            <label asp-for="IsAvailable" class="form-check-label">Available for order</label>
        </div>

        <div class="form-actions">
            <a class="btn btn-secondary btn-sm" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary btn-sm">Add Item</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
