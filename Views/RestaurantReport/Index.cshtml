@model HMS.Models.ViewModels.RestaurantReportViewModel
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Restaurant Sales Report";
    var periods = new[] { "daily", "weekly", "monthly" };
}

<partial name="_SurfaceHead" model="@(new SurfaceHead
{
    Title = "Restaurant Reports",
    Actions =
    [
        new SurfaceAction
        {
            Label = "Export CSV",
            Href = Url.Action("ExportCsv", new { Model.Filter.Period, Model.Filter.StartDate, Model.Filter.EndDate })!,
            Css = "btn btn-secondary btn-sm"
        }
    ]
})" />

@* Period presets as chips; the exact range stays available beside them. *@
<div class="chip-row">
    @foreach (var period in periods)
    {
        <a class="chip @(string.Equals(Model.Filter.Period, period, StringComparison.OrdinalIgnoreCase) ? "is-active" : "")"
           asp-action="Index" asp-route-Period="@period">
            @(char.ToUpper(period[0]) + period[1..])
        </a>
    }
</div>

<form class="filter-bar" method="get">
    <input type="hidden" name="Period" value="@Model.Filter.Period" />
    <div class="filter-field">
        <label for="startDate">From</label>
        <input id="startDate" type="date" name="StartDate" value="@Model.Filter.StartDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter-field">
        <label for="endDate">To</label>
        <input id="endDate" type="date" name="EndDate" value="@Model.Filter.EndDate.ToString("yyyy-MM-dd")" />
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
</form>

<div class="kpi-strip">
    <div class="kpi">
        <span class="kpi-label">Total revenue</span>
        <span class="kpi-value">Ksh @Model.TotalRevenue.ToString("N0")</span>
        <span class="kpi-sub">Paid orders in range</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Orders completed</span>
        <span class="kpi-value">@Model.TotalOrders</span>
        <span class="kpi-sub">Checked out</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Average order</span>
        <span class="kpi-value">
            Ksh @((Model.TotalOrders == 0 ? 0 : Model.TotalRevenue / Model.TotalOrders).ToString("N0"))
        </span>
        <span class="kpi-sub">Per settled bill</span>
    </div>
</div>

<div class="dash-columns">
    <section class="card">
        <header class="dash-panel-head">
            <h2 class="dash-panel-title">Top selling dishes</h2>
        </header>

        @if (!Model.TopItems.Any())
        {
            <p class="dash-panel-clear">No sales in this period.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-cards report-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Item</th>
                            <th class="text-center">Sold</th>
                            <th class="text-end pe-4">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.TopItems)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.Name</td>
                                <td data-label="Sold" class="text-center">@item.Quantity</td>
                                <td data-label="Revenue" class="text-end fw-semibold pe-4">Ksh @item.Revenue.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <header class="dash-panel-head">
            <h2 class="dash-panel-title">Waiter performance</h2>
        </header>

        @if (!Model.TopWaiters.Any())
        {
            <p class="dash-panel-clear">No waiter records in this period.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-cards report-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Waiter</th>
                            <th class="text-center">Orders</th>
                            <th class="text-end pe-4">Sales</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in Model.TopWaiters)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@w.Name</td>
                                <td data-label="Orders" class="text-center">@w.OrderCount</td>
                                <td data-label="Sales" class="text-end fw-semibold pe-4">Ksh @w.Revenue.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
