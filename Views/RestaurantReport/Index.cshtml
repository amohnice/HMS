@model HMS.Models.ViewModels.RestaurantReportViewModel
@{
    ViewData["Title"] = "Restaurant Sales Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-0 fw-bold">Restaurant Reports</h1>
        <p class="text-muted mb-0">Analyze revenues, order volumes, waiters, and product trends</p>
    </div>
    <div>
        <a asp-action="ExportCsv" asp-route-Period="@Model.Filter.Period" asp-route-StartDate="@Model.Filter.StartDate" asp-route-EndDate="@Model.Filter.EndDate" class="btn btn-outline-primary d-inline-flex align-items-center">
            <svg class="me-2" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Export CSV
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold">Reporting Period</label>
                <select name="Period" class="form-select" onchange="this.form.submit()">
                    @foreach (var period in new[] { "daily", "weekly", "monthly" })
                    {
                        if (Model.Filter.Period?.ToLower() == period)
                        {
                            <option value="@period" selected>@(char.ToUpper(period[0]) + period.Substring(1))</option>
                        }
                        else
                        {
                            <option value="@period">@(char.ToUpper(period[0]) + period.Substring(1))</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Start Date</label>
                <input type="date" name="StartDate" class="form-control" value="@Model.Filter.StartDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">End Date</label>
                <input type="date" name="EndDate" class="form-control" value="@Model.Filter.EndDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Apply Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card bg-primary text-white border-0 stat-card">
            <div class="card-body">
                <span class="text-white-50 small fw-bold uppercase">TOTAL REVENUE</span>
                <h2 class="fw-bold mt-1 mb-0">Ksh @Model.TotalRevenue.ToString("N2")</h2>
                <div class="small text-white-50 mt-2">Paid orders in selected range</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-success text-white border-0 stat-card">
            <div class="card-body">
                <span class="text-white-50 small fw-bold uppercase">ORDERS COMPLETED</span>
                <h2 class="fw-bold mt-1 mb-0">@Model.TotalOrders</h2>
                <div class="small text-white-50 mt-2">Transactions successfully checked out</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Top Items -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold">Top Selling Food Items</h5>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 report-table">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Item Name</th>
                            <th class="text-center">Quantity Sold</th>
                            <th class="text-end pe-3">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TopItems.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">No sales data for this period.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.TopItems)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@item.Name</td>
                                    <td class="text-center fw-bold">@item.Quantity</td>
                                    <td class="text-end fw-bold text-primary pe-3">Ksh @item.Revenue.ToString("N0")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Top Waiters -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold">Top Waiters Performance</h5>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 report-table">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Waiter Name</th>
                            <th class="text-center">Orders Served</th>
                            <th class="text-end pe-3">Total Sales</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TopWaiters.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">No waiter records for this period.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var w in Model.TopWaiters)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@w.Name</td>
                                    <td class="text-center fw-bold">@w.OrderCount</td>
                                    <td class="text-end fw-bold text-primary pe-3">Ksh @w.Revenue.ToString("N0")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
