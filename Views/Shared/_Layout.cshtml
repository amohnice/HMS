@using System.Security.Claims
@using HMS.Models.ViewModels
@using HMS.Services.Navigation
@inject INavBadgeService BadgeService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HMS.styles.css" asp-append-version="true" />
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    @*
        ONE shell for every role. What differs between roles is the manifest in
        Services/Navigation/NavigationManifest.cs — never the markup below.
        Pages may optionally define two sections:
          ContextColumn — categories / status queues / date presets (zone 2)
          TopBarTools   — chips that belong beside the search (e.g. kitchen counters)
    *@
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var shell = new ShellViewModel
    {
        Role       = role,
        UserName   = User.Identity?.Name ?? "User",
        Controller = ViewContext.RouteData.Values["controller"]?.ToString(),
        Action     = ViewContext.RouteData.Values["action"]?.ToString(),
        Items      = NavigationManifest.For(role),
        Badges     = await BadgeService.GetBadgesAsync(role)
    };

    <div class="shell @(shell.IsKds ? "shell--kds" : "")" id="shell">

        <partial name="_Rail" model="shell" />
        <div class="rail-overlay" id="railOverlay"></div>

        <div class="shell-main">

            <header class="topbar">
                <button class="topbar-toggle" id="railToggle" type="button" aria-label="Toggle navigation">
                    <partial name="_Icon" model="@("menu")" />
                </button>

                <form class="topbar-search" asp-controller="Home" asp-action="Search" method="get" role="search">
                    <span class="topbar-search-icon"><partial name="_Icon" model="@("search")" /></span>
                    <input type="search" name="q" placeholder="Search menu, orders and more" autocomplete="off"
                           value="@(ViewContext.HttpContext.Request.Query["q"])" />
                </form>

                @if (IsSectionDefined("TopBarTools"))
                {
                    <div class="topbar-tools">
                        @await RenderSectionAsync("TopBarTools", required: false)
                    </div>
                }

                <div class="topbar-right">
                    <button class="topbar-icon-btn" type="button" aria-label="Notifications">
                        <partial name="_Icon" model="@("bell")" />
                    </button>

                    <div class="topbar-user">
                        <div class="topbar-avatar">@shell.Initial</div>
                        <div class="topbar-user-meta">
                            <span class="topbar-user-name">@shell.UserName</span>
                            <span class="topbar-user-role">@shell.Role</span>
                        </div>
                    </div>
                </div>
            </header>

            <div class="shell-body">
                @if (IsSectionDefined("ContextColumn"))
                {
                    <aside class="context-col">
                        @await RenderSectionAsync("ContextColumn", required: false)
                    </aside>
                }

                <main class="surface">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="app-alert app-alert-success" id="successAlert">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            @TempData["SuccessMessage"]
                            <button class="app-alert-close" onclick="this.parentElement.remove()">&times;</button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="app-alert app-alert-error" id="errorAlert">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            @TempData["ErrorMessage"]
                            <button class="app-alert-close" onclick="this.parentElement.remove()">&times;</button>
                        </div>
                    }

                    @RenderBody()
                </main>
            </div>
        </div>

        <partial name="_BottomDock" model="shell" />
        <partial name="_Drawer" />
    </div>
}
else
{
    <!-- Unauthenticated: bare page for Login -->
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const shell   = document.getElementById('shell');
        const toggle  = document.getElementById('railToggle');
        const overlay = document.getElementById('railOverlay');

        // One toggle, two behaviours: on wide screens it collapses the rail to
        // icons; below 1024px the rail is already icons, so it swings out over
        // the content instead.
        const isTablet = () => window.matchMedia('(max-width: 1023.98px)').matches;

        function closeRail() {
            shell?.classList.remove('is-rail-open');
            overlay?.classList.remove('is-visible');
        }

        toggle?.addEventListener('click', function () {
            if (!shell) return;
            if (isTablet()) {
                const open = shell.classList.toggle('is-rail-open');
                overlay?.classList.toggle('is-visible', open);
            } else {
                shell.classList.toggle('is-rail-collapsed');
                try {
                    localStorage.setItem('hms.rail.collapsed',
                        shell.classList.contains('is-rail-collapsed') ? '1' : '0');
                } catch (e) { /* private mode: the preference just will not persist */ }
            }
        });

        overlay?.addEventListener('click', closeRail);
        window.addEventListener('resize', function () { if (!isTablet()) closeRail(); });

        try {
            if (localStorage.getItem('hms.rail.collapsed') === '1') shell?.classList.add('is-rail-collapsed');
        } catch (e) { /* ignore */ }

        // Auto-dismiss alerts
        setTimeout(function () {
            document.getElementById('successAlert')?.remove();
            document.getElementById('errorAlert')?.remove();
        }, 4000);

        // Live clock, for pages that render one (kitchen display).
        const clock = document.getElementById('kdsClock');
        if (clock) {
            const tick = function () {
                clock.textContent = new Date().toLocaleTimeString([],
                    { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            };
            tick();
            setInterval(tick, 1000);
        }

        // Kitchen counters read straight off the cards rendered on the page.
        ['Pending', 'Preparing', 'Ready'].forEach(function (status) {
            const el = document.getElementById('kds' + status + 'Count');
            if (el) el.textContent = document.querySelectorAll('[data-kds-status="' + status + '"]').length;
        });
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
