@model ErrorViewModel
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Error";
}

<partial name="_EmptyState" model="@(new EmptyState
{
    Icon = "help",
    Title = "Something went wrong",
    Text = "The request could not be completed. Trying again often clears it; if it keeps happening, pass the reference below to whoever supports this system.",
    Action = new SurfaceAction
    {
        Label = "Back to dashboard",
        Href = Url.Action("Index", "Home")!,
        Css = "btn btn-primary btn-sm"
    }
})" />

@if (Model.ShowRequestId)
{
    <div class="form-page">
        <dl class="form-review">
            <div class="form-review-row">
                <dt>Reference</dt>
                <dd><code>@Model.RequestId</code></dd>
            </div>
        </dl>
    </div>
}
