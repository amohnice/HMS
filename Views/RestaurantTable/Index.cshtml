@model IEnumerable<HMS.Models.Restaurant.RestaurantTable>
@using HMS.Models
@{
    ViewData["Title"] = "Table Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-0 fw-bold">Restaurant Tables</h1>
        <p class="text-muted">Monitor and manage dining room layouts, capacity, and current occupancies</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <div>
            <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center">
                <svg class="me-2" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Create Table
            </a>
        </div>
    }
</div>

<div class="row g-4">
    @foreach (var table in Model)
    {
        var statusClass = table.Status switch
        {
            TableStatus.Available => "status-available",
            TableStatus.Occupied => "status-occupied",
            TableStatus.Reserved => "status-reserved",
            TableStatus.Cleaning => "status-cleaning",
            _ => "bg-light text-dark"
        };

        var statusBorderColor = table.Status switch
        {
            TableStatus.Available => "border-success",
            TableStatus.Occupied => "border-danger",
            TableStatus.Reserved => "border-primary",
            TableStatus.Cleaning => "border-warning",
            _ => ""
        };

        <div class="col-md-6 col-lg-4 col-xl-3">
            <div class="card h-100 shadow-sm border-2 @statusBorderColor">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-4 fw-bold">Table @table.TableNumber</span>
                            <span class="badge-status @statusClass">@table.Status</span>
                        </div>
                        <div class="mb-3">
                            <span class="text-muted">Capacity:</span>
                            <strong class="fs-5">@table.Capacity @(table.Capacity == 1 ? "Person" : "People")</strong>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <!-- Quick Status Toggles -->
                        <form asp-action="UpdateStatus" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@table.Id" />
                            <label class="form-label text-muted small fw-bold">Quick Status Update</label>
                            <div class="input-group input-group-sm">
                                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                    @foreach (TableStatus s in Enum.GetValues(typeof(TableStatus)))
                                    {
                                        if (table.Status == s)
                                        {
                                            <option value="@s" selected>@s</option>
                                        }
                                        else
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    }
                                </select>
                            </div>
                        </form>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="d-flex justify-content-between">
                                <a asp-action="Edit" asp-route-id="@table.Id" class="btn btn-sm btn-outline-primary py-1 px-3">Edit</a>
                                <a asp-action="Delete" asp-route-id="@table.Id" class="btn btn-sm btn-outline-danger py-1 px-3">Delete</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
