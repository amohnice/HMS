@model IEnumerable<HMS.Models.Restaurant.RestaurantTable>
@using HMS.Models
@using HMS.Models.ViewModels
@using HMS.Services.Ui
@{
    ViewData["Title"] = "Table Management";

    var canManage = User.IsInRole("Admin") || User.IsInRole("Manager");
    var tables = Model.ToList();

    var head = new SurfaceHead
    {
        Title = "Tables",
        Count = tables.Count.ToString()
    };

    if (canManage)
    {
        head.Actions.Add(new SurfaceAction
        {
            Label = "Create Table", Icon = "plus",
            Href = Url.Action("Create")!,
            Css = "btn btn-primary btn-sm",
            OpensDrawer = true, DrawerTitle = "New table"
        });
    }

    @* Occupancy at a glance, from the same records already loaded. *@
    var byStatus = tables.GroupBy(t => t.Status).ToDictionary(g => g.Key, g => g.Count());
}

<partial name="_SurfaceHead" model="head" />

<div class="chip-row">
    @foreach (var status in Enum.GetValues<TableStatus>())
    {
        var pill = StatusStyle.From(status);
        <span class="chip">
            @pill.Text
            <span class="chip-count">@(byStatus.TryGetValue(status, out var n) ? n : 0)</span>
        </span>
    }
</div>

@if (tables.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyState
    {
        Icon = "table",
        Title = "No tables set up yet",
        Text = "Add the dining room's tables so waiters can attach orders to them.",
        Action = canManage
            ? new SurfaceAction { Label = "Create Table", Icon = "plus", Href = Url.Action("Create")!, OpensDrawer = true, DrawerTitle = "New table" }
            : null
    })" />
}
else
{
    <div class="card-grid">
        @if (canManage)
        {
            <a class="add-tile" href="@Url.Action("Create")" data-drawer data-drawer-title="New table">
                <span class="add-tile-mark"><partial name="_Icon" model="@("plus")" /></span>
                Add New Table
            </a>
        }

        @foreach (var table in tables)
        {
            <div class="entity-card table-card-@table.Status.ToString().ToLower()">
                <div class="entity-card-top">
                    <span class="entity-card-title mb-0">Table @table.TableNumber</span>
                    <partial name="_StatusPill" model="StatusStyle.From(table.Status)" />
                </div>

                <div class="entity-card-desc">
                    Seats @table.Capacity @(table.Capacity == 1 ? "person" : "people")
                </div>

                @* Status is the thing floor staff change most, so it stays one tap away. *@
                <form asp-action="UpdateStatus" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@table.Id" />
                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()"
                            aria-label="Update status for table @table.TableNumber">
                        @foreach (var s in Enum.GetValues<TableStatus>())
                        {
                            <option value="@s" selected="@(table.Status == s)">@s</option>
                        }
                    </select>
                </form>

                @if (canManage)
                {
                    <div class="entity-card-foot">
                        <span class="text-muted small">#@table.Id</span>
                        <span class="btn-group">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = table.Id })"
                               data-drawer data-drawer-title="Edit Table @table.TableNumber">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" href="@Url.Action("Delete", new { id = table.Id })"
                               data-drawer data-drawer-title="Delete Table @table.TableNumber">Delete</a>
                        </span>
                    </div>
                }
            </div>
        }
    </div>
}
