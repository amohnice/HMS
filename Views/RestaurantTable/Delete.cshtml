@model HMS.Models.Restaurant.RestaurantTable
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Delete Table";
}

<partial name="_SurfaceHead" model="@(new SurfaceHead { Title = "Delete Table" })" />

<div class="form-page">
    <a class="form-back btn btn-sm btn-secondary align-self-start" asp-action="Index">Back to tables</a>

    <form class="form-card" asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="form-warning">
            <span>
                Deleting <strong>Table @Model.TableNumber</strong> cannot be undone, and
                records attached to it are removed or restricted with it.
            </span>
        </div>

        <dl class="form-review">
            <div class="form-review-row"><dt>Table Number</dt><dd>@Model.TableNumber</dd></div>
            <div class="form-review-row"><dt>Capacity</dt><dd>@Model.Capacity seats</dd></div>
            <div class="form-review-row"><dt>Current Status</dt><dd>@Model.Status</dd></div>
        </dl>

        <div class="form-actions">
            <a class="btn btn-secondary btn-sm" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-danger btn-sm">Delete Table</button>
        </div>
    </form>
</div>
