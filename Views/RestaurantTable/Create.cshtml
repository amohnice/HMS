@model HMS.Models.Restaurant.RestaurantTable
@using HMS.Models
@using HMS.Models.ViewModels
@{
    ViewData["Title"] = "Create Table";
}

<partial name="_SurfaceHead" model="@(new SurfaceHead { Title = "Create Table" })" />

<div class="form-page">
    <a class="form-back btn btn-sm btn-secondary align-self-start" asp-action="Index">Back to tables</a>

    <form class="form-card" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-field">
            <label asp-for="TableNumber" class="form-label">Table Number</label>
            <input asp-for="TableNumber" class="form-control" placeholder="e.g. T4" required />
            <span asp-validation-for="TableNumber" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label asp-for="Capacity" class="form-label">Capacity</label>
                <input asp-for="Capacity" type="number" min="1" max="50" class="form-control" placeholder="4" required />
                <span class="form-hint">Seats.</span>
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<TableStatus>()" class="form-select" required></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <a class="btn btn-secondary btn-sm" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary btn-sm">Create Table</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
