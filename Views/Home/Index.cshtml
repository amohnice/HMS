@model HMS.Models.ViewModels.DashboardViewModel
@using HMS.Models.ViewModels
@using HMS.Services.Navigation
@using HMS.Services.Ui
@{
    ViewData["Title"] = "Dashboard";

    @* Quick actions come from the same manifest that builds the rail, so the two
       can never drift. Dashboard and Logout are not "actions" worth a tile. *@
    var shortcuts = NavigationManifest.For(Model.Role)
        .Where(i => i.Controller != "Home")
        .Take(6)
        .ToList();
}

<div class="surface-head">
    <h1 class="surface-title">@Model.Greeting, @Model.DisplayName</h1>
    <div class="surface-head-actions">
        <span class="text-muted small">@DateTime.Now.ToString("dddd, dd MMM · HH:mm")</span>
    </div>
</div>

@if (Model.Kpis.Count > 0)
{
    <div class="kpi-strip">
        @foreach (var kpi in Model.Kpis)
        {
            <div class="kpi">
                <span class="kpi-label">@kpi.Label</span>
                <span class="kpi-value">@kpi.Value</span>
                @if (kpi.Sub is not null)
                {
                    <span class="kpi-sub">@kpi.Sub</span>
                }
            </div>
        }
    </div>
}

@if (Model.IsRestaurant && Model.LiveOrders.Orders.Count > 0)
{
    <div>
        <h2 class="page-section-title">On the floor now</h2>
        <partial name="_OrderQueue" model="Model.LiveOrders" />
    </div>
}

<div class="dash-columns">

    @* ---------- Needs attention ---------- *@
    @if (Model.IsRestaurant)
    {
        <section class="card dash-panel">
            <header class="dash-panel-head">
                <h2 class="dash-panel-title">Needs attention</h2>
                @if (Model.NeedsAttention.Count > 0)
                {
                    <span class="dash-panel-count">@Model.NeedsAttention.Count</span>
                }
            </header>

            @if (Model.NeedsAttention.Count == 0)
            {
                <p class="dash-panel-clear">Nothing is running late.</p>
            }
            else
            {
                <ul class="dash-list">
                    @foreach (var item in Model.NeedsAttention)
                    {
                        <li>
                            <a class="dash-row" href="@item.Href">
                                <span class="dash-row-main">
                                    <span class="dash-row-title">@item.Title</span>
                                    <span class="dash-row-detail">@item.Detail</span>
                                </span>
                                <span class="dash-row-side">
                                    @if (item.Pill is not null)
                                    {
                                        <partial name="_StatusPill" model="item.Pill" />
                                    }
                                    <span class="dash-row-age">@item.Minutes m</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>
    }

    @* ---------- Low stock ---------- *@
    @if (Model.IsShop)
    {
        <section class="card dash-panel">
            <header class="dash-panel-head">
                <h2 class="dash-panel-title">Low stock</h2>
                @if (Model.ProductsHref is not null)
                {
                    <a class="dash-panel-link" href="@Model.ProductsHref">All products</a>
                }
            </header>

            @if (Model.LowStock.Count == 0)
            {
                <p class="dash-panel-clear">Every product is above the reorder level.</p>
            }
            else
            {
                <ul class="dash-list">
                    @foreach (var product in Model.LowStock)
                    {
                        var pill = StatusStyle.Stock(product.StockQuantity);
                        <li>
                            <a class="dash-row" href="@Url.Action("Edit", "ShopProduct", new { id = product.Id })"
                               data-drawer data-drawer-title="Restock @product.Name">
                                <span class="dash-row-main">
                                    <span class="dash-row-title">@product.Name</span>
                                    <span class="dash-row-detail">@product.Category</span>
                                </span>
                                <span class="dash-row-side">
                                    <partial name="_StatusPill" model="pill" />
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>
    }

    @* ---------- Tables in use ---------- *@
    @if (Model.IsRestaurant)
    {
        <section class="card dash-panel">
            <header class="dash-panel-head">
                <h2 class="dash-panel-title">Tables in use</h2>
                @if (Model.TablesHref is not null)
                {
                    <a class="dash-panel-link" href="@Model.TablesHref">Floor plan</a>
                }
            </header>

            @if (Model.BusyTables.Count == 0)
            {
                <p class="dash-panel-clear">Every table is free.</p>
            }
            else
            {
                <ul class="dash-list">
                    @foreach (var table in Model.BusyTables)
                    {
                        var pill = StatusStyle.From(table.Status);
                        <li>
                            <span class="dash-row">
                                <span class="dash-row-main">
                                    <span class="dash-row-title">Table @table.TableNumber</span>
                                    <span class="dash-row-detail">Seats @table.Capacity</span>
                                </span>
                                <span class="dash-row-side">
                                    <partial name="_StatusPill" model="pill" />
                                </span>
                            </span>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>

@if (shortcuts.Count > 0)
{
    <div>
        <h2 class="page-section-title">Jump to</h2>
        <div class="shortcut-row">
            @foreach (var item in shortcuts)
            {
                <a class="shortcut" asp-controller="@item.Controller" asp-action="@item.Action">
                    <span class="shortcut-icon"><partial name="_Icon" model="@item.Icon" /></span>
                    <span>@item.Label</span>
                </a>
            }
        </div>
    </div>
}
