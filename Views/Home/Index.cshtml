@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-header">
    <div>
        <h1 class="dashboard-title">Dashboard</h1>
        <p class="dashboard-subtitle">A quick overview of the hotel operations.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Stat Cards -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card card" style="background: var(--primary-gradient); color: white;">
            <div class="stat-icon">
                <svg width="52" height="52" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            </div>
            <div class="stat-label">Menu Items</div>
            <div class="stat-value">@ViewBag.MenuCount</div>
            <div class="stat-sub">Active dishes</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card card" style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color: white;">
            <div class="stat-icon">
                <svg width="52" height="52" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            </div>
            <div class="stat-label">Tables</div>
            <div class="stat-value">@ViewBag.TableCount</div>
            <div class="stat-sub">Total tables</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card card" style="background: var(--warning-gradient); color: white;">
            <div class="stat-icon">
                <svg width="52" height="52" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div class="stat-label">Pending</div>
            <div class="stat-value">@ViewBag.PendingOrders</div>
            <div class="stat-sub">Orders waiting</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card card" style="background: var(--success-gradient); color: white;">
            <div class="stat-icon">
                <svg width="52" height="52" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
            </div>
            <div class="stat-label">Products</div>
            <div class="stat-value">@ViewBag.ProductCount</div>
            <div class="stat-sub">Shop catalogue</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card card" style="background: var(--danger-gradient); color: white;">
            <div class="stat-icon">
                <svg width="52" height="52" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            <div class="stat-label">Low Stock</div>
            <div class="stat-value">@ViewBag.LowStock</div>
            <div class="stat-sub">Items to reorder</div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<h2 class="page-section-title">Quick Actions</h2>
<div class="row g-3">

    @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Waiter"))
    {
        <div class="col-12 col-md-6 col-xl-4">
            <a asp-controller="RestaurantOrder" asp-action="Create" class="quick-tile">
                <div class="quick-tile-icon accent-indigo">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                </div>
                <div class="quick-tile-content">
                    <div class="quick-tile-title">New Restaurant Order</div>
                    <div class="quick-tile-subtitle">Take a table order</div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            <a asp-controller="RestaurantTable" asp-action="Index" class="quick-tile">
                <div class="quick-tile-icon accent-sky">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                </div>
                <div class="quick-tile-content">
                    <div class="quick-tile-title">View Tables</div>
                    <div class="quick-tile-subtitle">Check table status</div>
                </div>
            </a>
        </div>
    }

    @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Kitchen"))
    {
        <div class="col-12 col-md-6 col-xl-4">
            <a asp-controller="Kitchen" asp-action="Index" class="quick-tile">
                <div class="quick-tile-icon accent-amber">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"></path></svg>
                </div>
                <div class="quick-tile-content">
                    <div class="quick-tile-title">Kitchen Display</div>
                    <div class="quick-tile-subtitle">Manage active orders</div>
                </div>
            </a>
        </div>
    }

    @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Cashier"))
    {
        <div class="col-12 col-md-6 col-xl-4">
            <a asp-controller="RestaurantCashier" asp-action="Index" class="quick-tile">
                <div class="quick-tile-icon accent-emerald">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                </div>
                <div class="quick-tile-content">
                    <div class="quick-tile-title">Restaurant Cashier</div>
                    <div class="quick-tile-subtitle">Collect payments</div>
                </div>
            </a>
        </div>
    }

    @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("ShopCashier"))
    {
        <div class="col-12 col-md-6 col-xl-4">
            <a asp-controller="ShopCashier" asp-action="Index" class="quick-tile">
                <div class="quick-tile-icon accent-violet">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                </div>
                <div class="quick-tile-content">
                    <div class="quick-tile-title">Shop POS</div>
                    <div class="quick-tile-subtitle">Process shop sales</div>
                </div>
            </a>
        </div>
    }

    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <div class="col-12 col-md-6 col-xl-4">
            <a asp-controller="RestaurantReport" asp-action="Index" class="quick-tile">
                <div class="quick-tile-icon accent-rose">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                </div>
                <div class="quick-tile-content">
                    <div class="quick-tile-title">Reports</div>
                    <div class="quick-tile-subtitle">Sales & revenue</div>
                </div>
            </a>
        </div>
    }

</div>
