@model HMS.Models.ViewModels.SearchResultsViewModel
@{
    ViewData["Title"] = "Search";
}

<div class="surface-head">
    <h1 class="surface-title">
        Search
        @if (Model.Query.Length >= 2)
        {
            <span class="surface-count">&ldquo;@Model.Query&rdquo; · @Model.Hits.Count</span>
        }
    </h1>
</div>

@if (Model.Query.Length < 2)
{
    <div class="card p-4 text-center text-muted">
        <div class="fw-semibold">Type at least two characters</div>
        <div class="small">Dishes, products, tables, orders and staff are all searchable.</div>
    </div>
}
else if (Model.Hits.Count == 0)
{
    <div class="card p-4 text-center text-muted">
        <div class="fw-semibold">No matches for &ldquo;@Model.Query&rdquo;</div>
        <div class="small">Try a dish name, barcode, table number or order number.</div>
    </div>
}
else
{
    foreach (var group in Model.Groups)
    {
        <div>
            <h2 class="page-section-title">@group.Key<span class="ms-1">(@group.Count())</span></h2>
            <div class="card">
                @foreach (var hit in group)
                {
                    <a class="search-hit" asp-controller="@hit.Controller" asp-action="@hit.Action" asp-route-id="@hit.Id">
                        <span class="search-hit-icon"><partial name="_Icon" model="@hit.Icon" /></span>
                        <span class="search-hit-body">
                            <span class="search-hit-title">@hit.Title</span>
                            <span class="search-hit-meta">@hit.Meta</span>
                        </span>
                        <span class="search-hit-go"><partial name="_Icon" model="@("chevron-r")" /></span>
                    </a>
                }
            </div>
        </div>
    }
}
